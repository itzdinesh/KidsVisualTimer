---

---

<div id="yt-player" style="display:none;"></div>

<div class="petal-layer" id="petalLayer"></div>

<div class="player">
  <div class="thumb" id="thumb"><span id="thumbText">ला</span></div>
  <div class="track-info">
    <div class="name" id="trackName">Mehndi Laga Ke Rakhna</div>
    <div class="film" id="trackFilm">Dilwale Dulhania Le Jayenge</div>
  </div>
  <button class="navbtn" id="prevBtn" aria-label="Previous song">
    <svg viewBox="0 0 24 24" fill="currentColor"
      ><path d="M6 6h2v12H6zM20 6 10 12l10 6z"></path></svg
    >
  </button>
  <button class="playbtn" id="playBtn" aria-label="Play">
    <svg viewBox="0 0 24 24" fill="currentColor"
      ><path d="M8 5v14l11-7z"></path></svg
    >
  </button>
  <button class="navbtn" id="nextBtn" aria-label="Next song">
    <svg viewBox="0 0 24 24" fill="currentColor"
      ><path d="M16 6h2v12h-2zM4 6l10 6-10 6z"></path></svg
    >
  </button>
  <button class="navbtn" id="queueBtn" aria-label="Song list">
    <svg viewBox="0 0 24 24" fill="currentColor"
      ><path d="M3 5h18v2H3zm0 4h18v2H3zm0 4h12v2H3zm0 4h12v2H3z"></path></svg
    >
  </button>
  <div class="scrub">
    <span class="time" id="currentTime">0:00</span>
    <div class="track" id="scrubTrack">
      <div class="fill" id="scrubFill" style="width:0%;"></div>
    </div>
    <span class="time" id="durationTime">0:00</span>
  </div>
  <svg
    class="player-divider"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    style="flex-shrink:0; opacity:.55;"
    aria-hidden="true"
  >
    <g fill="var(--marigold)">
      <circle cx="12" cy="6" r="3.4"></circle><circle cx="12" cy="18" r="3.4"
      ></circle>
      <circle cx="6" cy="12" r="3.4"></circle><circle cx="18" cy="12" r="3.4"
      ></circle>
    </g>
    <circle cx="12" cy="12" r="2.6" fill="var(--gold)"></circle>
  </svg>
  <div class="vol">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      ><path d="M11 5 6 9H2v6h4l5 4V5z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"
      ></path></svg
    >
    <div class="track"><div class="fill"></div></div>
  </div>
</div>

<!-- Song list panel -->
<div class="queue-panel" id="queuePanel">
  <div class="queue-header">
    <span class="queue-title" id="queueTitle">Song List</span>
    <button class="queue-close" id="queueClose" aria-label="Close song list"
      >&times;</button
    >
  </div>
  <div class="queue-list" id="queueList"></div>
</div>

<script>
  declare global {
    interface Window {
      onYouTubeIframeAPIReady?: () => void;
      YT?: any;
    }
  }

  interface Track {
    name: string;
    film: string;
    initials: string;
  }

  /* ══════════════════════════════════
     STATE
     ══════════════════════════════════ */
  let ytPlayer: any = null;
  let ytTracks: Track[] = [];
  let ytCurrent = 0;
  let lastVolume = 70;
  let activeTabKey = "90s";
  let playerReady = false;
  let tabGeneration = 0;

  /* ══════════════════════════════════
     TAB CONFIG — all YouTube
     ══════════════════════════════════ */
  const TABS: Record<
    string,
    { playlistId?: string; videoId?: string; label: string }
  > = {
    "90s": {
      playlistId: "PLx-w3AV6zlXc9_Lb7XCu9pUqKwx5Ks-gT",
      label: "90s Songs",
    },
    sangeet: {
      playlistId: "PLgXhzSm6SicnRgXUhJ8vcpOwXuKN5bq1L",
      label: "Sangeet",
    },
    dj: {
      playlistId: "PLhpQVqcKgcsDtj_Sa-MVs7g8-Bcgm-CVW",
      label: "DJ Songs",
    },
    vidaai: {
      playlistId: "PLs2BwwasMKCqqn_FJBotEqClFJWNowzq5",
      label: "Vidaai",
    },
  };

  /* ══════════════════════════════════
     UTILITIES
     ══════════════════════════════════ */
  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? "0" : ""}${secs}`;
  }

  function updatePlayButtonState(isPlaying: boolean) {
    const playBtn = document.getElementById("playBtn");
    if (!playBtn) return;
    playBtn.innerHTML = isPlaying
      ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    playBtn.setAttribute("aria-label", isPlaying ? "Pause" : "Play");
  }

  function setTrackUI(name: string, film: string, initials?: string) {
    const thumbText = document.getElementById("thumbText");
    const trackName = document.getElementById("trackName");
    const trackFilm = document.getElementById("trackFilm");
    if (thumbText) thumbText.textContent = initials || name.charAt(0) || "🎵";
    if (trackName) trackName.textContent = name;
    if (trackFilm) trackFilm.textContent = film;
  }

  function parseTrackTitle(rawTitle: string, defaultAuthor: string): Track {
    let songName = rawTitle.trim();
    let filmName = defaultAuthor;
    if (songName.includes(" | ")) {
      const p = songName.split(" | ");
      songName = p[0].trim();
      filmName = p[1].trim();
    } else if (songName.includes("|")) {
      const p = songName.split("|");
      songName = p[0].trim();
      filmName = p[1].trim();
    } else if (songName.includes(" - ")) {
      const p = songName.split(" - ");
      songName = p[0].trim();
      filmName = p.slice(1).join(" - ").trim();
    }
    return {
      name: songName,
      film: filmName,
      initials: Array.from(songName.trim())[0] || "🎵",
    };
  }

  async function fetchPlaylistTracks(videoIds: string[]): Promise<Track[]> {
    return Promise.all(
      videoIds.map(async (id) => {
        try {
          const res = await fetch(
            `https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`,
          );
          if (!res.ok) throw new Error("oembed failed");
          const data = await res.json();
          return parseTrackTitle(
            data.title || "Untitled",
            data.author_name || "YouTube",
          );
        } catch {
          return { name: `Track ${id}`, film: "YouTube", initials: "🎵" };
        }
      }),
    );
  }

  /* ══════════════════════════════════
     SONG LIST / QUEUE PANEL
     ══════════════════════════════════ */
  const queuePanel = document.getElementById("queuePanel");
  const queueList = document.getElementById("queueList");
  const queueBtn = document.getElementById("queueBtn");
  const queueClose = document.getElementById("queueClose");

  function buildQueueList(tracks: Track[], activeIdx: number) {
    if (!queueList) return;
    queueList.innerHTML = "";
    tracks.forEach((t, i) => {
      const item = document.createElement("div");
      item.className = "queue-item" + (i === activeIdx ? " active" : "");
      item.innerHTML = `<span class="queue-idx">${i + 1}</span><span class="queue-track"><span class="queue-name">${t.name}</span><span class="queue-film">${t.film}</span></span>`;
      item.addEventListener("click", () => {
        if (ytPlayer && typeof ytPlayer.playVideoAt === "function") {
          ytPlayer.playVideoAt(i);
          ytCurrent = i;
          setTrackUI(t.name, t.film, t.initials);
          updatePlayButtonState(true);
          updateQueueHighlight(i);
          queuePanel?.classList.remove("open");
        }
      });
      queueList.appendChild(item);
    });
  }

  function updateQueueHighlight(activeIdx: number) {
    if (!queueList) return;
    queueList.querySelectorAll(".queue-item").forEach((el, i) => {
      el.classList.toggle("active", i === activeIdx);
    });
  }

  queueBtn?.addEventListener("click", () => {
    queuePanel?.classList.toggle("open");
  });

  queueClose?.addEventListener("click", () => {
    queuePanel?.classList.remove("open");
  });

  /* ══════════════════════════════════
     SPRINKLE / PETAL LAYER
     ══════════════════════════════════ */
  const petalLayer = document.getElementById("petalLayer");
  let sprinkleInterval: ReturnType<typeof setInterval> | null = null;
  const MAX_SPRINKLES = 15;

  function spawnSprinkle() {
    if (!petalLayer) return;
    if (petalLayer.children.length >= MAX_SPRINKLES) return;
    const el = document.createElement("div");
    el.className = "sprinkle";
    const colors = ["#E8871E", "#D4A017", "#AD1F5C", "#FFC93C", "#F7ECD9"];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.left = Math.random() * 100 + "%";
    el.style.setProperty("--fall-duration", 3 + Math.random() * 3 + "s");
    el.style.setProperty("--drift", Math.random() * 60 - 30 + "px");
    el.style.setProperty("--spin", Math.random() * 720 - 360 + "deg");
    el.addEventListener("animationend", () => el.remove());
    petalLayer.appendChild(el);
  }

  function startSprinkles() {
    if (sprinkleInterval) return;
    sprinkleInterval = setInterval(
      () => spawnSprinkle(),
      400 + Math.random() * 300,
    );
  }

  function stopSprinkles() {
    if (sprinkleInterval) {
      clearInterval(sprinkleInterval);
      sprinkleInterval = null;
    }
  }

  /* ══════════════════════════════════
     THEME PARTICLE SYSTEMS
     ══════════════════════════════════ */
  let confettiInterval: ReturnType<typeof setInterval> | null = null;
  let vidaaiInterval: ReturnType<typeof setInterval> | null = null;

  function clearThemeParticles() {
    if (confettiInterval) { clearInterval(confettiInterval); confettiInterval = null; }
    if (vidaaiInterval) { clearInterval(vidaaiInterval); vidaaiInterval = null; }
  }

  function spawnConfetti() {
    const layer = document.getElementById("confettiLayer");
    if (!layer) return;
    if (layer.children.length >= 20) return;
    const el = document.createElement("div");
    el.className = "confetti";
    const colors = ["#FF6B9D", "#FFD23F", "#E8871E", "#AD1F5C", "#FF9ECD", "#fff"];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.left = Math.random() * 100 + "%";
    el.style.setProperty("--conf-speed", (3 + Math.random() * 3) + "s");
    el.style.setProperty("--conf-drift", (Math.random() * 60 - 30) + "px");
    el.style.setProperty("--conf-spin", (Math.random() * 720 - 360) + "deg");
    el.style.animationDelay = Math.random() * 2 + "s";
    el.addEventListener("animationend", () => el.remove());
    layer.appendChild(el);
  }

  function spawnVidaaiPetal() {
    const layer = document.getElementById("vidaaiPetals");
    if (!layer) return;
    if (layer.children.length >= 12) return;
    const el = document.createElement("div");
    el.className = "vidaai-petal";
    const colors = ["#E8A0B0", "#C890D0", "#F7ECD9", "#D4A0A0", "#B080A0"];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.left = Math.random() * 100 + "%";
    el.style.setProperty("--vp-speed", (5 + Math.random() * 4) + "s");
    el.style.setProperty("--vp-drift", (Math.random() * 40 - 20) + "px");
    el.style.setProperty("--vp-spin", (Math.random() * 360) + "deg");
    el.style.animationDelay = Math.random() * 3 + "s";
    el.addEventListener("animationend", () => el.remove());
    layer.appendChild(el);
  }

  function spawnThemeParticles(tabKey: string) {
    clearThemeParticles();
    /* clear existing particles */
    const confLayer = document.getElementById("confettiLayer");
    const vidaaiLayer = document.getElementById("vidaaiPetals");
    if (confLayer) confLayer.innerHTML = "";
    if (vidaaiLayer) vidaaiLayer.innerHTML = "";

    if (tabKey === "sangeet") {
      confettiInterval = setInterval(spawnConfetti, 500);
    } else if (tabKey === "vidaai") {
      vidaaiInterval = setInterval(spawnVidaaiPetal, 700);
    }
  }

  /* ══════════════════════════════════
     YOUTUBE PLAYER (unified for all tabs)
     ══════════════════════════════════ */
  function updateYTProgress() {
    if (
      !ytPlayer ||
      typeof ytPlayer.getCurrentTime !== "function"
    )
      return;
    const cur = ytPlayer.getCurrentTime() || 0;
    const dur = ytPlayer.getDuration() || 0;
    const currentTimeEl = document.getElementById("currentTime");
    const durationTimeEl = document.getElementById("durationTime");
    const scrubFillEl = document.getElementById("scrubFill");
    if (currentTimeEl) currentTimeEl.textContent = formatTime(cur);
    if (durationTimeEl) durationTimeEl.textContent = formatTime(dur);
    if (scrubFillEl)
      scrubFillEl.style.width = dur > 0 ? (cur / dur) * 100 + "%" : "0%";

    if (typeof ytPlayer.getPlaylistIndex === "function") {
      const idx = ytPlayer.getPlaylistIndex();
      if (idx >= 0 && idx < ytTracks.length && idx !== ytCurrent) {
        ytCurrent = idx;
        const t = ytTracks[ytCurrent];
        if (t) setTrackUI(t.name, t.film, t.initials);
        updateQueueHighlight(ytCurrent);
      }
    }
  }

  setInterval(() => updateYTProgress(), 500);

  async function loadTab(tabKey: string) {
    const cfg = TABS[tabKey];
    if (!cfg || !ytPlayer) return;
    activeTabKey = tabKey;

    /* bump generation — any in-flight fetch from a previous tab is now stale */
    const gen = ++tabGeneration;

    /* immediately clear tracks + queue */
    ytTracks = [];
    ytCurrent = 0;
    if (queueList) {
      queueList.innerHTML = '<div class="queue-item" style="opacity:.5;pointer-events:none;"><span class="queue-track"><span class="queue-name">Loading songs...</span></span></div>';
    }

    /* load playlist or single video */
    if (cfg.playlistId) {
      ytPlayer.loadPlaylist({
        list: cfg.playlistId,
        listType: "playlist",
      });
    } else if (cfg.videoId) {
      ytPlayer.loadVideoById(cfg.videoId);
    }

    /* fetch track titles via oembed */
    if (cfg.playlistId) {
      try {
        await new Promise((r) => setTimeout(r, 1500));
        if (gen !== tabGeneration) return; /* stale — another tab was switched */
        if (ytPlayer && typeof ytPlayer.getPlaylist === "function") {
          const videoIds = ytPlayer.getPlaylist();
          if (Array.isArray(videoIds) && videoIds.length > 0) {
            const tracks = await fetchPlaylistTracks(videoIds);
            if (gen !== tabGeneration) return; /* stale */
            ytTracks = tracks;
            ytCurrent = 0;
            if (ytTracks.length > 0) {
              const t = ytTracks[0];
              setTrackUI(t.name, t.film, t.initials);
            }
            buildQueueList(ytTracks, 0);
            return;
          }
        }
      } catch {
        if (gen !== tabGeneration) return;
      }
    }

    /* single video: fetch its title */
    if (cfg.videoId) {
      const tracks = await fetchPlaylistTracks([cfg.videoId]);
      if (gen !== tabGeneration) return; /* stale */
      ytTracks = tracks;
      ytCurrent = 0;
      if (tracks.length > 0) {
        setTrackUI(tracks[0].name, tracks[0].film, tracks[0].initials);
      }
      buildQueueList(tracks, 0);
    }
  }

  function initYTPlayer() {
    if (!window.YT || !window.YT.Player) return;
    const firstCfg = TABS[activeTabKey];

    const playerVars: Record<string, any> = {};
    if (firstCfg?.playlistId) {
      playerVars.listType = "playlist";
      playerVars.list = firstCfg.playlistId;
    }

    ytPlayer = new window.YT.Player("yt-player", {
      height: "0",
      width: "0",
      playerVars,
      events: {
        onReady: async () => {
          playerReady = true;
          const gen = tabGeneration;
          /* if single video, load it now */
          if (firstCfg?.videoId && ytPlayer.loadVideoById) {
            ytPlayer.loadVideoById(firstCfg.videoId);
          }
          /* fetch track list */
          if (firstCfg?.playlistId && typeof ytPlayer.getPlaylist === "function") {
            const videoIds = ytPlayer.getPlaylist();
            if (Array.isArray(videoIds) && videoIds.length > 0) {
              const tracks = await fetchPlaylistTracks(videoIds);
              if (gen !== tabGeneration) return; /* stale */
              ytTracks = tracks;
              ytCurrent = 0;
              if (tracks.length > 0) {
                const t = tracks[0];
                setTrackUI(t.name, t.film, t.initials);
              }
              buildQueueList(tracks, 0);
            }
          } else if (firstCfg?.videoId) {
            const tracks = await fetchPlaylistTracks([firstCfg.videoId]);
            if (gen !== tabGeneration) return; /* stale */
            ytTracks = tracks;
            ytCurrent = 0;
            if (tracks.length > 0) {
              setTrackUI(tracks[0].name, tracks[0].film, tracks[0].initials);
            }
            buildQueueList(tracks, 0);
          }
        },
        onStateChange: (event: any) => {
          const isPlaying = event.data === 1;
          updatePlayButtonState(isPlaying);
          updateYTProgress();
          if (isPlaying) startSprinkles();
          else stopSprinkles();
        },
      },
    });
  }

  if (window.YT && window.YT.Player) {
    initYTPlayer();
  } else {
    window.onYouTubeIframeAPIReady = initYTPlayer;
    if (
      !document.querySelector(
        'script[src="https://www.youtube.com/iframe_api"]',
      )
    ) {
      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      const first = document.getElementsByTagName("script")[0];
      if (first?.parentNode) first.parentNode.insertBefore(tag, first);
      else document.head.appendChild(tag);
    }
  }

  /* ══════════════════════════════════
     TAB SWITCHING
     ══════════════════════════════════ */
  function waitForPlayerStop(): Promise<void> {
    return new Promise((resolve) => {
      if (!ytPlayer || typeof ytPlayer.getPlayerState !== "function") {
        resolve();
        return;
      }
      const state = ytPlayer.getPlayerState();
      /* already stopped (-1) or ended (0) */
      if (state === -1 || state === 0) {
        resolve();
        return;
      }
      /* wait for onStateChange to confirm stop, with timeout fallback */
      let resolved = false;
      const done = () => {
        if (resolved) return;
        resolved = true;
        resolve();
      };
      setTimeout(done, 300);
      /* poll as backup since onStateChange may not fire for stopVideo */
      const poll = setInterval(() => {
        try {
          const s = ytPlayer.getPlayerState();
          if (s === -1 || s === 0 || s === 2) {
            clearInterval(poll);
            done();
          }
        } catch {
          clearInterval(poll);
          done();
        }
      }, 50);
    });
  }

  async function switchTab(tab: HTMLElement) {
    const tabKey = tab.dataset.tabKey || "";
    if (tab.classList.contains("active")) return;
    if (!TABS[tabKey]) return;

    /* fully stop current audio — stopVideo is more reliable than pauseVideo */
    if (ytPlayer && typeof ytPlayer.stopVideo === "function") {
      ytPlayer.stopVideo();
    }
    await waitForPlayerStop();
    stopSprinkles();

    /* immediately clear all state */
    ytTracks = [];
    ytCurrent = 0;
    tabGeneration++;

    /* reset UI to neutral */
    updatePlayButtonState(false);
    setTrackUI("Loading...", "", "🎵");
    const scrubFillEl = document.getElementById("scrubFill");
    const currentTimeEl = document.getElementById("currentTime");
    const durationTimeEl = document.getElementById("durationTime");
    if (scrubFillEl) scrubFillEl.style.width = "0%";
    if (currentTimeEl) currentTimeEl.textContent = "0:00";
    if (durationTimeEl) durationTimeEl.textContent = "0:00";

    /* clear queue panel immediately */
    if (queueList) {
      queueList.innerHTML = '<div class="queue-item" style="opacity:.5;pointer-events:none;"><span class="queue-track"><span class="queue-name">Loading songs...</span></span></div>';
    }
    queuePanel?.classList.remove("open");

    document
      .querySelectorAll(".tab")
      .forEach((t) => t.classList.remove("active"));
    tab.classList.add("active");

    /* apply theme */
    document.body.setAttribute("data-theme", tabKey);
    spawnThemeParticles(tabKey);

    /* load new tab */
    loadTab(tabKey);
  }

  document.addEventListener("click", (e) => {
    const tab = (e.target as HTMLElement).closest(".tab") as HTMLElement;
    if (tab && tab.closest("#sourceTabs")) {
      switchTab(tab);
    }
  });

  /* ══════════════════════════════════
     PLAYER CONTROLS
     ══════════════════════════════════ */

  /* ── prev ── */
  const prevBtn = document.getElementById("prevBtn");
  if (prevBtn) {
    prevBtn.addEventListener("click", () => {
      if (ytPlayer && typeof ytPlayer.previousVideo === "function") {
        ytPlayer.previousVideo();
      }
    });
  }

  /* ── next ── */
  const nextBtn = document.getElementById("nextBtn");
  if (nextBtn) {
    nextBtn.addEventListener("click", () => {
      if (ytPlayer && typeof ytPlayer.nextVideo === "function") {
        ytPlayer.nextVideo();
      }
    });
  }

  /* ── play / pause ── */
  const playBtn = document.getElementById("playBtn");
  if (playBtn) {
    playBtn.addEventListener("click", () => {
      if (!ytPlayer) return;
      const state = ytPlayer.getPlayerState ? ytPlayer.getPlayerState() : -1;
      if (state === 1) {
        ytPlayer.pauseVideo();
        updatePlayButtonState(false);
        stopSprinkles();
      } else {
        ytPlayer.playVideo();
        updatePlayButtonState(true);
        startSprinkles();
      }
    });
  }

  /* ── scrub ── */
  const scrubTrackEl = document.getElementById("scrubTrack");
  let scrubRaf: number | null = null;
  let scrubPendingPct = -1;
  function flushScrubSeek() {
    if (scrubPendingPct < 0) return;
    if (scrubRaf !== null) { cancelAnimationFrame(scrubRaf); scrubRaf = null; }
    if (ytPlayer && typeof ytPlayer.getDuration === "function") {
      const dur = ytPlayer.getDuration() || 0;
      if (dur > 0) ytPlayer.seekTo(scrubPendingPct * dur, true);
    }
    scrubPendingPct = -1;
  }
  if (scrubTrackEl) {
    makeDraggable(scrubTrackEl, (pct) => {
      scrubPendingPct = pct;
      if (scrubRaf === null) {
        scrubRaf = requestAnimationFrame(() => {
          scrubRaf = null;
          if (scrubPendingPct < 0) return;
          if (ytPlayer && typeof ytPlayer.getDuration === "function") {
            const dur = ytPlayer.getDuration() || 0;
            if (dur > 0) ytPlayer.seekTo(scrubPendingPct * dur, true);
          }
          scrubPendingPct = -1;
        });
      }
    });
    scrubTrackEl.addEventListener("mouseup", flushScrubSeek);
    scrubTrackEl.addEventListener("touchend", flushScrubSeek);
    document.addEventListener("mouseup", flushScrubSeek);
    document.addEventListener("touchend", flushScrubSeek);
  }

  /* ── volume ── */
  function makeDraggable(
    trackEl: HTMLElement,
    onChange: (pct: number) => void,
  ) {
    const fill = trackEl.querySelector(".fill") as HTMLElement;
    if (!fill) return;
    function setFromEvent(clientX: number) {
      const rect = trackEl.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      fill.style.width = pct * 100 + "%";
      onChange(pct);
    }
    trackEl.addEventListener("mousedown", (e: MouseEvent) => {
      e.preventDefault();
      setFromEvent(e.clientX);
      function move(e: MouseEvent) {
        setFromEvent(e.clientX);
      }
      function up() {
        document.removeEventListener("mousemove", move);
        document.removeEventListener("mouseup", up);
      }
      document.addEventListener("mousemove", move);
      document.addEventListener("mouseup", up);
    });
    trackEl.addEventListener("touchstart", (e: TouchEvent) => {
      e.preventDefault();
      setFromEvent(e.touches[0].clientX);
      function move(e: TouchEvent) {
        e.preventDefault();
        setFromEvent(e.touches[0].clientX);
      }
      function end() {
        document.removeEventListener("touchmove", move);
        document.removeEventListener("touchend", end);
      }
      document.addEventListener("touchmove", move, { passive: false });
      document.addEventListener("touchend", end);
    }, { passive: false });
  }

  const volTrack = document.querySelector(".vol .track") as HTMLElement;
  const volIcon = document.querySelector(".vol svg") as HTMLElement;
  if (volTrack && volIcon) {
    makeDraggable(volTrack, (pct) => {
      lastVolume = Math.round(pct * 100);
      volIcon.style.opacity = lastVolume === 0 ? ".45" : "1";
      if (
        ytPlayer &&
        typeof ytPlayer.setVolume === "function"
      ) {
        ytPlayer.setVolume(lastVolume);
      }
    });
    volIcon.addEventListener("click", () => {
      const fill = volTrack.querySelector(".fill") as HTMLElement;
      if (!fill) return;
      const isMuted = fill.style.width === "0%";
      fill.style.width = isMuted ? lastVolume + "%" : "0%";
      volIcon.style.opacity = isMuted ? "1" : ".45";
      if (
        ytPlayer &&
        typeof ytPlayer.setVolume === "function"
      ) {
        ytPlayer.setVolume(isMuted ? lastVolume : 0);
      }
    });
  }
</script>
