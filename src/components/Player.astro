---
---

<div id="yt-player" style="display:none;"></div>

<div class="petal-layer" id="petalLayer"></div>

<div class="player">
  <div class="thumb" id="thumb"><span id="thumbText">ला</span></div>
  <div class="track-info">
    <div class="name" id="trackName">Mehndi Laga Ke Rakhna</div>
    <div class="film" id="trackFilm">Dilwale Dulhania Le Jayenge</div>
  </div>
  <button class="navbtn" id="prevBtn" aria-label="Previous song">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zM20 6 10 12l10 6z"/></svg>
  </button>
  <button class="playbtn" id="playBtn" aria-label="Play">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
  </button>
  <button class="navbtn" id="nextBtn" aria-label="Next song">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM4 6l10 6-10 6z"/></svg>
  </button>
  <div class="scrub">
    <span class="time" id="currentTime">0:00</span>
    <div class="track" id="scrubTrack"><div class="fill" id="scrubFill" style="width:0%;"></div></div>
    <span class="time" id="durationTime">0:00</span>
  </div>
  <svg width="18" height="18" viewBox="0 0 24 24" style="flex-shrink:0; opacity:.55;" aria-hidden="true">
    <g fill="var(--marigold)">
      <circle cx="12" cy="6" r="3.4"/><circle cx="12" cy="18" r="3.4"/>
      <circle cx="6" cy="12" r="3.4"/><circle cx="18" cy="12" r="3.4"/>
    </g>
    <circle cx="12" cy="12" r="2.6" fill="var(--gold)"/>
  </svg>
  <div class="vol">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
    <div class="track"><div class="fill"></div></div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      onYouTubeIframeAPIReady?: () => void;
      YT?: any;
    }
  }

  interface Track {
    name: string;
    film: string;
    initials: string;
  }

  const PLAYLIST_ID = 'PLTGEaM6uPj_EEPv9gnijXesdghvSjJhHZ';
  let player: any = null;

  let tracks: Track[] = [];
  let current = 0;

  /* ── persistence across page navigations ── */
  const STORAGE_KEY = 'dsRadio';
  function saveState() {
    if (!player || typeof player.getCurrentTime !== 'function') return;
    const state = {
      idx: current,
      time: player.getCurrentTime() || 0,
      vol: lastVolume,
      wasPlaying: player.getPlayerState?.() === (window.YT?.PlayerState?.PLAYING ?? 1)
    };
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch {}
  }
  function loadState(): { idx: number; time: number; vol: number; wasPlaying: boolean } | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      return JSON.parse(raw);
    } catch { return null; }
  }
  setInterval(saveState, 2000);

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function updatePlayButtonState(state?: number) {
    const playBtn = document.getElementById('playBtn');
    if (!playBtn) return;
    const currentState = state !== undefined ? state : (player && typeof player.getPlayerState === 'function' ? player.getPlayerState() : -1);
    const isPlaying = currentState === (window.YT?.PlayerState?.PLAYING ?? 1);
    playBtn.innerHTML = isPlaying
      ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    playBtn.setAttribute('aria-label', isPlaying ? 'Pause' : 'Play');
  }

  /* ── sprinkle / ambient petal layer ── */
  const petalLayer = document.getElementById('petalLayer');
  let sprinkleInterval: ReturnType<typeof setInterval> | null = null;
  const MAX_SPRINKLES = 15;

  function spawnSprinkle() {
    if (!petalLayer) return;
    if (petalLayer.children.length >= MAX_SPRINKLES) return;

    const el = document.createElement('div');
    el.className = 'sprinkle';

    const colors = ['#E8871E', '#D4A017', '#AD1F5C', '#FFC93C', '#F7ECD9'];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];

    el.style.left = Math.random() * 100 + '%';
    el.style.setProperty('--fall-duration', (3 + Math.random() * 3) + 's');
    el.style.setProperty('--drift', (Math.random() * 60 - 30) + 'px');
    el.style.setProperty('--spin', (Math.random() * 720 - 360) + 'deg');

    el.addEventListener('animationend', () => el.remove());
    petalLayer.appendChild(el);
  }

  function startSprinkles() {
    if (sprinkleInterval) return;
    sprinkleInterval = setInterval(() => {
      spawnSprinkle();
    }, 400 + Math.random() * 300);
  }

  function stopSprinkles() {
    if (sprinkleInterval) {
      clearInterval(sprinkleInterval);
      sprinkleInterval = null;
    }
  }

  function updateTrackUI() {
    if (tracks.length === 0) return;
    const t = tracks[current];
    if (!t) return;
    const thumbText = document.getElementById('thumbText');
    const trackName = document.getElementById('trackName');
    const trackFilm = document.getElementById('trackFilm');
    if (thumbText) thumbText.textContent = t.initials;
    if (trackName) trackName.textContent = t.name;
    if (trackFilm) trackFilm.textContent = t.film;
  }

  function updateProgress() {
    const currentTimeEl = document.getElementById('currentTime');
    const durationTimeEl = document.getElementById('durationTime');
    const scrubFillEl = document.getElementById('scrubFill');

    if (player && typeof player.getCurrentTime === 'function' && typeof player.getDuration === 'function') {
      const currentSecs = player.getCurrentTime() || 0;
      const durationSecs = player.getDuration() || 0;

      if (currentTimeEl) currentTimeEl.textContent = formatTime(currentSecs);
      if (durationTimeEl) durationTimeEl.textContent = formatTime(durationSecs);

      if (scrubFillEl) {
        const pct = durationSecs > 0 ? (currentSecs / durationSecs) * 100 : 0;
        scrubFillEl.style.width = `${pct}%`;
      }

      if (typeof player.getPlaylistIndex === 'function') {
        const idx = player.getPlaylistIndex();
        if (idx >= 0 && idx < tracks.length && idx !== current) {
          current = idx;
          updateTrackUI();
        }
      }

      updatePlayButtonState();
    }
  }

  setInterval(updateProgress, 500);

  const scrubTrackEl = document.getElementById('scrubTrack');
  if (scrubTrackEl) {
    scrubTrackEl.addEventListener('click', (e: MouseEvent) => {
      if (!player || typeof player.getDuration !== 'function' || typeof player.seekTo !== 'function') return;
      const durationSecs = player.getDuration() || 0;
      if (durationSecs <= 0) return;

      const rect = scrubTrackEl.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const pct = Math.max(0, Math.min(1, clickX / rect.width));
      const seekTime = pct * durationSecs;
      player.seekTo(seekTime, true);
      updateProgress();
    });
  }

  function parseTrackTitle(rawTitle: string, defaultAuthor: string): { name: string; film: string; initials: string } {
    let songName = rawTitle.trim();
    let filmName = defaultAuthor;

    if (songName.includes(' | ')) {
      const parts = songName.split(' | ');
      songName = parts[0].trim();
      filmName = parts[1].trim();
    } else if (songName.includes('|')) {
      const parts = songName.split('|');
      songName = parts[0].trim();
      filmName = parts[1].trim();
    } else if (songName.includes(' - ')) {
      const parts = songName.split(' - ');
      songName = parts[0].trim();
      filmName = parts.slice(1).join(' - ').trim();
    }

    const initials = Array.from(songName.trim())[0] || '🎵';
    return { name: songName, film: filmName, initials };
  }

  async function fetchPlaylistTracks(videoIds: string[]): Promise<Track[]> {
    const fetched = await Promise.all(
      videoIds.map(async (id) => {
        try {
          const res = await fetch(`https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`);
          if (!res.ok) throw new Error('Failed to fetch oembed');
          const data = await res.json();
          const rawTitle = data.title || 'Untitled Song';
          return parseTrackTitle(rawTitle, data.author_name || 'YouTube');
        } catch (e) {
          return {
            name: `Track ${id}`,
            film: 'YouTube',
            initials: '🎵'
          };
        }
      })
    );
    return fetched;
  }

  function initYTPlayer() {
    if (window.YT && window.YT.Player) {
      player = new window.YT.Player('yt-player', {
        height: '0',
        width: '0',
        playerVars: {
          listType: 'playlist',
          list: PLAYLIST_ID
        },
        events: {
          onReady: async () => {
            console.log('player ready');

            const saved = loadState();
            if (saved) {
              lastVolume = saved.vol;
              if (player && typeof player.setVolume === 'function') {
                player.setVolume(lastVolume);
              }
            }

            if (player && typeof player.getPlaylist === 'function') {
              const videoIds = player.getPlaylist();
              if (Array.isArray(videoIds) && videoIds.length > 0) {
                const loadedTracks = await fetchPlaylistTracks(videoIds);
                if (loadedTracks.length > 0) {
                  tracks = loadedTracks;
                  const targetIdx = saved && saved.idx >= 0 && saved.idx < tracks.length ? saved.idx : 0;
                  if (targetIdx > 0 || (saved && saved.time > 0)) {
                    player.playVideoAt(targetIdx);
                    if (saved && saved.time > 0) {
                      setTimeout(() => {
                        if (player && typeof player.seekTo === 'function') {
                          player.seekTo(saved.time, true);
                          if (!saved.wasPlaying && typeof player.pauseVideo === 'function') {
                            player.pauseVideo();
                          }
                        }
                      }, 500);
                    }
                  } else {
                    updateProgress();
                  }
                  current = targetIdx;
                  updateTrackUI();
                }
              }
            }
          },
          onStateChange: (event: any) => {
            updatePlayButtonState(event.data);
            updateProgress();
            if (event.data === (window.YT?.PlayerState?.PLAYING ?? 1)) {
              startSprinkles();
            } else if (event.data === (window.YT?.PlayerState?.PAUSED ?? 2) || event.data === (window.YT?.PlayerState?.ENDED ?? 0)) {
              stopSprinkles();
            }
            saveState();
          }
        }
      });
    }
  }

  if (window.YT && window.YT.Player) {
    initYTPlayer();
  } else {
    window.onYouTubeIframeAPIReady = initYTPlayer;
    if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      const firstScriptTag = document.getElementsByTagName('script')[0];
      if (firstScriptTag && firstScriptTag.parentNode) {
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
      } else {
        document.head.appendChild(tag);
      }
    }
  }

  const prevBtn = document.getElementById('prevBtn');
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (player && typeof player.previousVideo === 'function') {
        player.previousVideo();
        saveState();
      }
    });
  }

  const nextBtn = document.getElementById('nextBtn');
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (player && typeof player.nextVideo === 'function') {
        player.nextVideo();
        saveState();
      }
    });
  }

  const playBtn = document.getElementById('playBtn');
  if (playBtn) {
    playBtn.addEventListener('click', ()=>{
      if (!player) return;
      const state = player.getPlayerState ? player.getPlayerState() : -1;
      if (state === (window.YT?.PlayerState?.PLAYING ?? 1)) {
        player.pauseVideo();
      } else {
        player.playVideo();
      }
      saveState();
    });
  }

  function makeDraggable(trackEl: HTMLElement, onChange: (pct: number) => void) {
    const fill = trackEl.querySelector('.fill') as HTMLElement;
    if (!fill) return;
    function setFromEvent(clientX: number) {
      const rect = trackEl.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      fill.style.width = (pct * 100) + '%';
      onChange(pct);
    }
    trackEl.addEventListener('mousedown', (e: MouseEvent) => {
      setFromEvent(e.clientX);
      function move(e: MouseEvent) { setFromEvent(e.clientX); }
      function up() {
        document.removeEventListener('mousemove', move);
        document.removeEventListener('mouseup', up);
      }
      document.addEventListener('mousemove', move);
      document.addEventListener('mouseup', up);
    });
    trackEl.addEventListener('touchstart', (e: TouchEvent) => { setFromEvent(e.touches[0].clientX); });
    trackEl.addEventListener('touchmove', (e: TouchEvent) => { setFromEvent(e.touches[0].clientX); });
  }

  const volTrack = document.querySelector('.vol .track') as HTMLElement;
  const volIcon = document.querySelector('.vol svg') as HTMLElement;
  let lastVolume = 70;
  if (volTrack && volIcon) {
    makeDraggable(volTrack, (pct) => {
      lastVolume = Math.round(pct * 100);
      volIcon.style.opacity = lastVolume === 0 ? '0.45' : '1';
      if (player && typeof player.setVolume === 'function') {
        player.setVolume(lastVolume);
      }
    });
    volIcon.addEventListener('click', () => {
      const fill = volTrack.querySelector('.fill') as HTMLElement;
      if (!fill) return;
      const isMuted = fill.style.width === '0%';
      fill.style.width = isMuted ? lastVolume + '%' : '0%';
      volIcon.style.opacity = isMuted ? '1' : '0.45';
      if (player && typeof player.setVolume === 'function') {
        player.setVolume(isMuted ? lastVolume : 0);
      }
    });
  }

  const scrubTrack = document.querySelector('.scrub .track') as HTMLElement;
  if (scrubTrack) {
    makeDraggable(scrubTrack, () => {});
  }
</script>
