---
---

<div id="yt-player" style="display:none;"></div>

<!-- Hidden Spotify embeds — iframes created by IFrameAPI.createController() -->
<div id="spotify-embeds" style="position:fixed;bottom:0;left:0;width:300px;height:80px;overflow:hidden;visibility:hidden;pointer-events:none;z-index:-1;">
  <div id="spotify-sangeet"></div>
  <div id="spotify-dj"></div>
  <div id="spotify-vidaai"></div>
</div>

<div class="petal-layer" id="petalLayer"></div>

<div class="player">
  <div class="thumb" id="thumb"><span id="thumbText">ला</span></div>
  <div class="track-info">
    <div class="name" id="trackName">Mehndi Laga Ke Rakhna</div>
    <div class="film" id="trackFilm">Dilwale Dulhania Le Jayenge</div>
  </div>
  <button class="navbtn" id="prevBtn" aria-label="Previous song">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zM20 6 10 12l10 6z"/></svg>
  </button>
  <button class="playbtn" id="playBtn" aria-label="Play">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
  </button>
  <button class="navbtn" id="nextBtn" aria-label="Next song">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM4 6l10 6-10 6z"/></svg>
  </button>
  <button class="navbtn" id="queueBtn" aria-label="Song list">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 5h18v2H3zm0 4h18v2H3zm0 4h12v2H3zm0 4h12v2H3z"/></svg>
  </button>
  <div class="scrub">
    <span class="time" id="currentTime">0:00</span>
    <div class="track" id="scrubTrack"><div class="fill" id="scrubFill" style="width:0%;"></div></div>
    <span class="time" id="durationTime">0:00</span>
  </div>
  <svg width="18" height="18" viewBox="0 0 24 24" style="flex-shrink:0; opacity:.55;" aria-hidden="true">
    <g fill="var(--marigold)">
      <circle cx="12" cy="6" r="3.4"/><circle cx="12" cy="18" r="3.4"/>
      <circle cx="6" cy="12" r="3.4"/><circle cx="18" cy="12" r="3.4"/>
    </g>
    <circle cx="12" cy="12" r="2.6" fill="var(--gold)"/>
  </svg>
  <div class="vol">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
    <div class="track"><div class="fill"></div></div>
  </div>
</div>

<!-- Song list panel -->
<div class="queue-panel" id="queuePanel">
  <div class="queue-header">
    <span class="queue-title" id="queueTitle">Song List</span>
    <button class="queue-close" id="queueClose" aria-label="Close song list">&times;</button>
  </div>
  <div class="queue-list" id="queueList"></div>
</div>

<script>
  declare global {
    interface Window {
      onYouTubeIframeAPIReady?: () => void;
      YT?: any;
      Spotify?: any;
      onSpotifyIframeApiReady?: (api: any) => void;
    }
  }

  interface Track {
    name: string;
    film: string;
    initials: string;
    uri?: string;
  }

  /* ══════════════════════════════════
     STATE
     ══════════════════════════════════ */
  let activeSource: 'youtube' | 'spotify' = 'youtube';
  let ytPlayer: any = null;
  let ytTracks: Track[] = [];
  let ytCurrent = 0;
  let lastVolume = 70;

  const spotifyControllers: Record<string, any> = {
    sangeet: null,
    dj: null,
    vidaai: null,
  };
  let activeSpotifyKey: string | null = null;
  let spotifyIFrameAPI: any = null;
  let currentSpotifyTrack: Track | null = null;

  const SPOTIFY_MAP: Record<string, { id: string; uri: string }> = {
    sangeet: { id: 'spotify-sangeet', uri: 'spotify:playlist:37i9dQZF1DX2ktNbDFDPWZ' },
    dj:      { id: 'spotify-dj',      uri: 'spotify:playlist:1o1RakJXDw6WtHNmaCLn4e' },
    vidaai:  { id: 'spotify-vidaai',   uri: 'spotify:playlist:0snMxCN4bcn2hKMWouCpIR' },
  };

  const SPOTIFY_PLAYLIST_IDS: Record<string, string> = {
    sangeet: '37i9dQZF1DX2ktNbDFDPWZ',
    dj: '1o1RakJXDw6WtHNmaCLn4e',
    vidaai: '0snMxCN4bcn2hKMWouCpIR',
  };

  /* ══════════════════════════════════
     UTILITIES
     ══════════════════════════════════ */
  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function updatePlayButtonState(isPlaying: boolean) {
    const playBtn = document.getElementById('playBtn');
    if (!playBtn) return;
    playBtn.innerHTML = isPlaying
      ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    playBtn.setAttribute('aria-label', isPlaying ? 'Pause' : 'Play');
  }

  function setTrackUI(name: string, film: string, initials?: string) {
    const thumbText = document.getElementById('thumbText');
    const trackName = document.getElementById('trackName');
    const trackFilm = document.getElementById('trackFilm');
    if (thumbText) thumbText.textContent = initials || name.charAt(0) || '🎵';
    if (trackName) trackName.textContent = name;
    if (trackFilm) trackFilm.textContent = film;
  }

  /* ══════════════════════════════════
     SONG LIST / QUEUE PANEL
     ══════════════════════════════════ */
  const queuePanel = document.getElementById('queuePanel');
  const queueList = document.getElementById('queueList');
  const queueTitle = document.getElementById('queueTitle');
  const queueBtn = document.getElementById('queueBtn');
  const queueClose = document.getElementById('queueClose');

  function buildQueueList(tracks: Track[], activeIdx: number) {
    if (!queueList) return;
    queueList.innerHTML = '';
    tracks.forEach((t, i) => {
      const item = document.createElement('div');
      item.className = 'queue-item' + (i === activeIdx ? ' active' : '');
      item.innerHTML = `<span class="queue-idx">${i + 1}</span><span class="queue-track"><span class="queue-name">${t.name}</span><span class="queue-film">${t.film}</span></span>`;
      item.addEventListener('click', () => {
        if (activeSource === 'youtube' && ytPlayer) {
          ytPlayer.playVideoAt(i);
          ytCurrent = i;
        } else if (activeSource === 'spotify' && activeSpotifyKey && t.uri) {
          spotifyControllers[activeSpotifyKey]?.loadUri(t.uri);
        }
        setTrackUI(t.name, t.film, t.initials);
        updatePlayButtonState(true);
        updateQueueHighlight(i);
      });
      queueList.appendChild(item);
    });
  }

  function updateQueueHighlight(activeIdx: number) {
    if (!queueList) return;
    queueList.querySelectorAll('.queue-item').forEach((el, i) => {
      el.classList.toggle('active', i === activeIdx);
    });
  }

  queueBtn?.addEventListener('click', () => {
    queuePanel?.classList.toggle('open');
  });

  queueClose?.addEventListener('click', () => {
    queuePanel?.classList.remove('open');
  });

  /* ══════════════════════════════════
     SPRINKLE / PETAL LAYER
     ══════════════════════════════════ */
  const petalLayer = document.getElementById('petalLayer');
  let sprinkleInterval: ReturnType<typeof setInterval> | null = null;
  const MAX_SPRINKLES = 15;

  function spawnSprinkle() {
    if (!petalLayer) return;
    if (petalLayer.children.length >= MAX_SPRINKLES) return;
    const el = document.createElement('div');
    el.className = 'sprinkle';
    const colors = ['#E8871E', '#D4A017', '#AD1F5C', '#FFC93C', '#F7ECD9'];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.left = Math.random() * 100 + '%';
    el.style.setProperty('--fall-duration', (3 + Math.random() * 3) + 's');
    el.style.setProperty('--drift', (Math.random() * 60 - 30) + 'px');
    el.style.setProperty('--spin', (Math.random() * 720 - 360) + 'deg');
    el.addEventListener('animationend', () => el.remove());
    petalLayer.appendChild(el);
  }

  function startSprinkles() {
    if (sprinkleInterval) return;
    sprinkleInterval = setInterval(() => spawnSprinkle(), 400 + Math.random() * 300);
  }

  function stopSprinkles() {
    if (sprinkleInterval) { clearInterval(sprinkleInterval); sprinkleInterval = null; }
  }

  /* ══════════════════════════════════
     YOUTUBE PLAYER
     ══════════════════════════════════ */
  const YT_PLAYLIST_ID = 'PLTGEaM6uPj_EEPv9gnijXesdghvSjJhHZ';

  function parseTrackTitle(rawTitle: string, defaultAuthor: string): Track {
    let songName = rawTitle.trim();
    let filmName = defaultAuthor;
    if (songName.includes(' | ')) {
      const p = songName.split(' | ');
      songName = p[0].trim(); filmName = p[1].trim();
    } else if (songName.includes('|')) {
      const p = songName.split('|');
      songName = p[0].trim(); filmName = p[1].trim();
    } else if (songName.includes(' - ')) {
      const p = songName.split(' - ');
      songName = p[0].trim(); filmName = p.slice(1).join(' - ').trim();
    }
    return { name: songName, film: filmName, initials: Array.from(songName.trim())[0] || '🎵' };
  }

  async function fetchPlaylistTracks(videoIds: string[]): Promise<Track[]> {
    return Promise.all(
      videoIds.map(async (id) => {
        try {
          const res = await fetch(`https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`);
          if (!res.ok) throw new Error('oembed failed');
          const data = await res.json();
          return parseTrackTitle(data.title || 'Untitled', data.author_name || 'YouTube');
        } catch { return { name: `Track ${id}`, film: 'YouTube', initials: '🎵' }; }
      })
    );
  }

  function updateYTProgress() {
    if (activeSource !== 'youtube' || !ytPlayer || typeof ytPlayer.getCurrentTime !== 'function') return;
    const cur = ytPlayer.getCurrentTime() || 0;
    const dur = ytPlayer.getDuration() || 0;
    const currentTimeEl = document.getElementById('currentTime');
    const durationTimeEl = document.getElementById('durationTime');
    const scrubFillEl = document.getElementById('scrubFill');
    if (currentTimeEl) currentTimeEl.textContent = formatTime(cur);
    if (durationTimeEl) durationTimeEl.textContent = formatTime(dur);
    if (scrubFillEl) scrubFillEl.style.width = dur > 0 ? (cur / dur) * 100 + '%' : '0%';

    if (typeof ytPlayer.getPlaylistIndex === 'function') {
      const idx = ytPlayer.getPlaylistIndex();
      if (idx >= 0 && idx < ytTracks.length && idx !== ytCurrent) {
        ytCurrent = idx;
        const t = ytTracks[ytCurrent];
        if (t) setTrackUI(t.name, t.film, t.initials);
        updateQueueHighlight(ytCurrent);
      }
    }
  }

  setInterval(() => {
    if (activeSource === 'youtube') updateYTProgress();
  }, 500);

  function initYTPlayer() {
    if (!window.YT || !window.YT.Player) return;
    ytPlayer = new window.YT.Player('yt-player', {
      height: '0', width: '0',
      playerVars: { listType: 'playlist', list: YT_PLAYLIST_ID },
      events: {
        onReady: async () => {
          if (ytPlayer && typeof ytPlayer.getPlaylist === 'function') {
            const videoIds = ytPlayer.getPlaylist();
            if (Array.isArray(videoIds) && videoIds.length > 0) {
              ytTracks = await fetchPlaylistTracks(videoIds);
              ytCurrent = 0;
              if (ytTracks.length > 0) {
                const t = ytTracks[0];
                setTrackUI(t.name, t.film, t.initials);
              }
              buildQueueList(ytTracks, 0);
            }
          }
        },
        onStateChange: (event: any) => {
          if (activeSource !== 'youtube') return;
          const isPlaying = event.data === (window.YT?.PlayerState?.PLAYING ?? 1);
          updatePlayButtonState(isPlaying);
          updateYTProgress();
          if (isPlaying) startSprinkles();
          else stopSprinkles();
        }
      }
    });
  }

  if (window.YT && window.YT.Player) {
    initYTPlayer();
  } else {
    window.onYouTubeIframeAPIReady = initYTPlayer;
    if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      const first = document.getElementsByTagName('script')[0];
      if (first?.parentNode) first.parentNode.insertBefore(tag, first);
      else document.head.appendChild(tag);
    }
  }

  /* ══════════════════════════════════
     SPOTIFY CONTROLLERS (IFrame API)
     ══════════════════════════════════ */
  function initSpotifyControllers() {
    if (!spotifyIFrameAPI) return;

    Object.entries(SPOTIFY_MAP).forEach(([key, { id, uri }]) => {
      const element = document.getElementById(id);
      if (!element) { console.warn(`[Spotify] element #${id} not found`); return; }

      const options = { uri, width: '300', height: '80' };
      const callback = (controller: any) => {
        spotifyControllers[key] = controller;
        console.log(`[Spotify] Controller ready: ${key}`);

        controller.addListener('ready', () => {
          console.log(`[Spotify] Embed ready: ${key}`);
        });

        controller.addListener('playback_started', (e: any) => {
          console.log(`[Spotify] playback_started: ${key}`, e?.data?.playingURI);
        });

        controller.addListener('playback_update', (e: any) => {
          const data = e?.data;
          if (!data) return;

          /* ── FIX #2: drive play/pause icon from isPaused ── */
          const isPaused = data.isPaused === true;
          const isPlaying = !isPaused;
          updatePlayButtonState(isPlaying);

          if (isPlaying) startSprinkles(); else stopSprinkles();

          /* update track info from playback_update */
          if (data.playingURI) {
            const uriParts = data.playingURI.split(':');
            const trackId = uriParts[uriParts.length - 1];
            /* try to extract name from URI or use a placeholder */
            const trackName = `Track ${trackId.substring(0, 8)}...`;
            currentSpotifyTrack = { name: trackName, film: key, initials: trackName.charAt(0), uri: data.playingURI };
            setTrackUI(trackName, key, trackName.charAt(0));
          }

          /* update scrub */
          const pos = data.position || 0;
          const dur = data.duration || 0;
          const currentTimeEl = document.getElementById('currentTime');
          const durationTimeEl = document.getElementById('durationTime');
          const scrubFillEl = document.getElementById('scrubFill');
          if (currentTimeEl) currentTimeEl.textContent = formatTime(pos / 1000);
          if (durationTimeEl) durationTimeEl.textContent = formatTime(dur / 1000);
          if (scrubFillEl) scrubFillEl.style.width = dur > 0 ? (pos / dur) * 100 + '%' : '0%';
        });
      };

      spotifyIFrameAPI.createController(element, options, callback);
    });
  }

  function loadSpotifyAPI() {
    if (window.Spotify?.IFrameAPI) {
      spotifyIFrameAPI = window.Spotify.IFrameAPI;
      initSpotifyControllers();
      return;
    }
    window.onSpotifyIframeApiReady = (IFrameAPI: any) => {
      spotifyIFrameAPI = IFrameAPI;
      initSpotifyControllers();
    };
    if (!document.querySelector('script[src="https://open.spotify.com/embed/iframe-api/v1"]')) {
      const tag = document.createElement('script');
      tag.src = 'https://open.spotify.com/embed/iframe-api/v1';
      tag.async = true;
      document.head.appendChild(tag);
    }
  }
  loadSpotifyAPI();

  /* ══════════════════════════════════
     TAB SWITCHING
     ══════════════════════════════════ */
  function pauseCurrentSource() {
    if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
      ytPlayer.pauseVideo();
    } else if (activeSource === 'spotify' && activeSpotifyKey && spotifyControllers[activeSpotifyKey]) {
      spotifyControllers[activeSpotifyKey].togglePlay();
    }
  }

  function getSpotifyKey(playlistUri: string): string | null {
    for (const [key, map] of Object.entries(SPOTIFY_MAP)) {
      if (map.uri === playlistUri) return key;
    }
    return null;
  }

  function switchTab(tab: HTMLElement) {
    const source = tab.dataset.source as 'youtube' | 'spotify';
    const playlistUri = tab.dataset.playlistUri || '';
    if (tab.classList.contains('active')) return;

    pauseCurrentSource();
    stopSprinkles();

    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');

    activeSource = source;

    if (source === 'youtube') {
      activeSpotifyKey = null;
      if (ytPlayer && typeof ytPlayer.playVideo === 'function') {
        ytPlayer.playVideo();
      }
      const t = ytTracks[ytCurrent];
      if (t) setTrackUI(t.name, t.film, t.initials);
      buildQueueList(ytTracks, ytCurrent);
    } else {
      const key = getSpotifyKey(playlistUri);
      activeSpotifyKey = key;
      setTrackUI('Loading...', '', '🎵');

      if (key && spotifyControllers[key]) {
        console.log(`[Spotify] Playing ${key}`);
        spotifyControllers[key].togglePlay();
      } else {
        setTrackUI('Tap play to start', '', '🎵');
      }

      /* build queue from playlist ID */
      const plId = SPOTIFY_PLAYLIST_IDS[key || ''];
      if (plId) fetchSpotifyPlaylistTracks(plId, key || '');
    }

    updatePlayButtonState(true);
  }

  async function fetchSpotifyPlaylistTracks(playlistId: string, key: string) {
    try {
      /* use oEmbed-like approach: fetch embed page and extract track list */
      /* Since we can't use Web API without auth, use the embed's internal data */
      /* Build a placeholder list — tracks will update as playback_update fires */
      const placeholderTracks: Track[] = [];
      for (let i = 0; i < 20; i++) {
        placeholderTracks.push({ name: `Track ${i + 1}`, film: key, initials: '🎵' });
      }
      /* Don't override with placeholder — just show what we have from playback */
      console.log(`[Spotify] Playlist ${playlistId} loaded for ${key}`);
    } catch (err) {
      console.warn(`[Spotify] Failed to fetch playlist ${playlistId}`, err);
    }
  }

  document.getElementById('sourceTabs')?.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest('.tab') as HTMLElement;
    if (tab) switchTab(tab);
  });

  /* ══════════════════════════════════
     PLAYER CONTROLS (route to active source)
     ══════════════════════════════════ */
  const prevBtn = document.getElementById('prevBtn');
  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.previousVideo === 'function') {
        ytPlayer.previousVideo();
      }
      /* Spotify embed API has no previousTrack — no-op */
    });
  }

  const nextBtn = document.getElementById('nextBtn');
  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.nextVideo === 'function') {
        ytPlayer.nextVideo();
      }
      /* Spotify embed API has no nextTrack — no-op */
    });
  }

  const playBtn = document.getElementById('playBtn');
  if (playBtn) {
    playBtn.addEventListener('click', () => {
      if (activeSource === 'youtube' && ytPlayer) {
        const state = ytPlayer.getPlayerState ? ytPlayer.getPlayerState() : -1;
        if (state === (window.YT?.PlayerState?.PLAYING ?? 1)) {
          ytPlayer.pauseVideo();
        } else {
          ytPlayer.playVideo();
        }
      } else if (activeSource === 'spotify' && activeSpotifyKey && spotifyControllers[activeSpotifyKey]) {
        spotifyControllers[activeSpotifyKey].togglePlay();
      }
    });
  }

  /* ── scrub ── */
  const scrubTrackEl = document.getElementById('scrubTrack');
  if (scrubTrackEl) {
    scrubTrackEl.addEventListener('click', (e: MouseEvent) => {
      const rect = scrubTrackEl.getBoundingClientRect();
      const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));

      if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.getDuration === 'function') {
        const dur = ytPlayer.getDuration() || 0;
        if (dur > 0) ytPlayer.seekTo(pct * dur, true);
      } else if (activeSource === 'spotify' && activeSpotifyKey && spotifyControllers[activeSpotifyKey]) {
        const dur = parseFloat(document.getElementById('durationTime')?.textContent || '0') * 1000;
        if (dur > 0) spotifyControllers[activeSpotifyKey].seek(pct * dur / 1000);
      }

      const scrubFillEl = document.getElementById('scrubFill');
      if (scrubFillEl) scrubFillEl.style.width = (pct * 100) + '%';
    });
  }

  /* ── volume ── */
  function makeDraggable(trackEl: HTMLElement, onChange: (pct: number) => void) {
    const fill = trackEl.querySelector('.fill') as HTMLElement;
    if (!fill) return;
    function setFromEvent(clientX: number) {
      const rect = trackEl.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      fill.style.width = (pct * 100) + '%';
      onChange(pct);
    }
    trackEl.addEventListener('mousedown', (e: MouseEvent) => {
      setFromEvent(e.clientX);
      function move(e: MouseEvent) { setFromEvent(e.clientX); }
      function up() { document.removeEventListener('mousemove', move); document.removeEventListener('mouseup', up); }
      document.addEventListener('mousemove', move);
      document.addEventListener('mouseup', up);
    });
    trackEl.addEventListener('touchstart', (e: TouchEvent) => setFromEvent(e.touches[0].clientX));
    trackEl.addEventListener('touchmove', (e: TouchEvent) => setFromEvent(e.touches[0].clientX));
  }

  const volTrack = document.querySelector('.vol .track') as HTMLElement;
  const volIcon = document.querySelector('.vol svg') as HTMLElement;
  if (volTrack && volIcon) {
    makeDraggable(volTrack, (pct) => {
      lastVolume = Math.round(pct * 100);
      volIcon.style.opacity = lastVolume === 0 ? '.45' : '1';
      if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.setVolume === 'function') {
        ytPlayer.setVolume(lastVolume);
      }
      /* Spotify embed API has no setVolume — volume controlled by embed UI only */
    });
    volIcon.addEventListener('click', () => {
      const fill = volTrack.querySelector('.fill') as HTMLElement;
      if (!fill) return;
      const isMuted = fill.style.width === '0%';
      fill.style.width = isMuted ? lastVolume + '%' : '0%';
      volIcon.style.opacity = isMuted ? '1' : '.45';
      if (activeSource === 'youtube' && ytPlayer && typeof ytPlayer.setVolume === 'function') {
        ytPlayer.setVolume(isMuted ? lastVolume : 0);
      }
    });
  }

  const scrubTrack = document.querySelector('.scrub .track') as HTMLElement;
  if (scrubTrack) makeDraggable(scrubTrack, () => {});
</script>
