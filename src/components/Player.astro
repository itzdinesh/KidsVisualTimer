  /* ══════════════════════════════════
     UTILITIES
     ══════════════════════════════════ */
  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? "0" : ""}${secs}`;
  }

  function updatePlayButtonState(isPlaying: boolean) {
    const playBtn = document.getElementById("playBtn");
    if (!playBtn) return;
    playBtn.innerHTML = isPlaying
      ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>'
      : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    playBtn.setAttribute("aria-label", isPlaying ? "Pause" : "Play");
  }

  function setTrackUI(name: string, film: string, initials?: string) {
    const thumbText = document.getElementById("thumbText");
    const trackName = document.getElementById("trackName");
    const trackFilm = document.getElementById("trackFilm");
    if (thumbText) thumbText.textContent = initials || name.charAt(0) || "🎵";
    if (trackName) trackName.textContent = name;
    if (trackFilm) trackFilm.textContent = film;
  }

  /* ══════════════════════════════════
     SONG LIST / QUEUE PANEL
     ══════════════════════════════════ */
  const queuePanel = document.getElementById("queuePanel");
  const queueList = document.getElementById("queueList");
  const queueTitle = document.getElementById("queueTitle");
  const queueBtn = document.getElementById("queueBtn");
  const queueClose = document.getElementById("queueClose");

  function buildQueueList(tracks: Track[], activeIdx: number) {
    if (!queueList) return;
    queueList.innerHTML = "";
    tracks.forEach((t, i) => {
      const item = document.createElement("div");
      item.className = "queue-item" + (i === activeIdx ? " active" : "");
      item.innerHTML = `<span class="queue-idx">${i + 1}</span><span class="queue-track"><span class="queue-name">${t.name}</span><span class="queue-film">${t.film}</span></span>`;
      item.addEventListener("click", () => {
        if (activeSource === "youtube" && ytPlayer) {
          ytPlayer.playVideoAt(i);
          ytCurrent = i;
          setTrackUI(t.name, t.film, t.initials);
          updatePlayButtonState(true);
          updateQueueHighlight(i);
        } else if (activeSource === "spotify" && activeSpotifyKey) {
          const key = activeSpotifyKey;
          if (t.uri) {
            startSpotifyNav(t.uri, key, i);
            queuePanel?.classList.remove("open");
          }
        }
      });
      queueList.appendChild(item);
    });
  }

  function updateQueueHighlight(activeIdx: number) {
    if (!queueList) return;
    queueList.querySelectorAll(".queue-item").forEach((el, i) => {
      el.classList.toggle("active", i === activeIdx);
    });
  }

  queueBtn?.addEventListener("click", () => {
    queuePanel?.classList.toggle("open");
  });

  queueClose?.addEventListener("click", () => {
    queuePanel?.classList.remove("open");
  });

  /* ══════════════════════════════════
     SPRINKLE / PETAL LAYER
     ══════════════════════════════════ */
  const petalLayer = document.getElementById("petalLayer");
  let sprinkleInterval: ReturnType<typeof setInterval> | null = null;
  const MAX_SPRINKLES = 15;

  function spawnSprinkle() {
    if (!petalLayer) return;
    if (petalLayer.children.length >= MAX_SPRINKLES) return;
    const el = document.createElement("div");
    el.className = "sprinkle";
    const colors = ["#E8871E", "#D4A017", "#AD1F5C", "#FFC93C", "#F7ECD9"];
    el.style.background = colors[Math.floor(Math.random() * colors.length)];
    el.style.left = Math.random() * 100 + "%";
    el.style.setProperty("--fall-duration", 3 + Math.random() * 3 + "s");
    el.style.setProperty("--drift", Math.random() * 60 - 30 + "px");
    el.style.setProperty("--spin", Math.random() * 720 - 360 + "deg");
    el.addEventListener("animationend", () => el.remove());
    petalLayer.appendChild(el);
  }

  function startSprinkles() {
    if (sprinkleInterval) return;
    sprinkleInterval = setInterval(
      () => spawnSprinkle(),
      400 + Math.random() * 300,
    );
  }

  function stopSprinkles() {
    if (sprinkleInterval) {
      clearInterval(sprinkleInterval);
      sprinkleInterval = null;
    }
  }

  /* ══════════════════════════════════
     YOUTUBE PLAYER
     ══════════════════════════════════ */
  const YT_PLAYLIST_ID = "PLTGEaM6uPj_EEPv9gnijXesdghvSjJhHZ";

  function parseTrackTitle(rawTitle: string, defaultAuthor: string): Track {
    let songName = rawTitle.trim();
    let filmName = defaultAuthor;
    if (songName.includes(" | ")) {
      const p = songName.split(" | ");
      songName = p[0].trim();
      filmName = p[1].trim();
    } else if (songName.includes("|")) {
      const p = songName.split("|");
      songName = p[0].trim();
      filmName = p[1].trim();
    } else if (songName.includes(" - ")) {
      const p = songName.split(" - ");
      songName = p[0].trim();
      filmName = p.slice(1).join(" - ").trim();
    }
    return {
      name: songName,
      film: filmName,
      initials: Array.from(songName.trim())[0] || "🎵",
    };
  }

  async function fetchPlaylistTracks(videoIds: string[]): Promise<Track[]> {
    return Promise.all(
      videoIds.map(async (id) => {
        try {
          const res = await fetch(
            `https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=${id}&format=json`,
          );
          if (!res.ok) throw new Error("oembed failed");
          const data = await res.json();
          return parseTrackTitle(
            data.title || "Untitled",
            data.author_name || "YouTube",
          );
        } catch {
          return { name: `Track ${id}`, film: "YouTube", initials: "🎵" };
        }
      }),
    );
  }

  function updateYTProgress() {
    if (
      activeSource !== "youtube" ||
      !ytPlayer ||
      typeof ytPlayer.getCurrentTime !== "function"
    )
      return;
    const cur = ytPlayer.getCurrentTime() || 0;
    const dur = ytPlayer.getDuration() || 0;
    const currentTimeEl = document.getElementById("currentTime");
    const durationTimeEl = document.getElementById("durationTime");
    const scrubFillEl = document.getElementById("scrubFill");
    if (currentTimeEl) currentTimeEl.textContent = formatTime(cur);
    if (durationTimeEl) durationTimeEl.textContent = formatTime(dur);
    if (scrubFillEl)
      scrubFillEl.style.width = dur > 0 ? (cur / dur) * 100 + "%" : "0%";

    if (typeof ytPlayer.getPlaylistIndex === "function") {
      const idx = ytPlayer.getPlaylistIndex();
      if (idx >= 0 && idx < ytTracks.length && idx !== ytCurrent) {
        ytCurrent = idx;
        const t = ytTracks[ytCurrent];
        if (t) setTrackUI(t.name, t.film, t.initials);
        updateQueueHighlight(ytCurrent);
      }
    }
  }

  setInterval(() => {
    if (activeSource === "youtube") updateYTProgress();
  }, 500);

  function initYTPlayer() {
    if (!window.YT || !window.YT.Player) return;
    ytPlayer = new window.YT.Player("yt-player", {
      height: "0",
      width: "0",
      playerVars: { listType: "playlist", list: YT_PLAYLIST_ID },
      events: {
        onReady: async () => {
          if (ytPlayer && typeof ytPlayer.getPlaylist === "function") {
            const videoIds = ytPlayer.getPlaylist();
            if (Array.isArray(videoIds) && videoIds.length > 0) {
              ytTracks = await fetchPlaylistTracks(videoIds);
              ytCurrent = 0;
              if (ytTracks.length > 0) {
                const t = ytTracks[0];
                setTrackUI(t.name, t.film, t.initials);
              }
              buildQueueList(ytTracks, 0);
            }
          }
        },
        onStateChange: (event: any) => {
          if (activeSource !== "youtube") return;
          const isPlaying = event.data === 1;
          updatePlayButtonState(isPlaying);
          updateYTProgress();
          if (isPlaying) startSprinkles();
          else stopSprinkles();
        },
      },
    });
  }

  if (window.YT && window.YT.Player) {
    initYTPlayer();
  } else {
    window.onYouTubeIframeAPIReady = initYTPlayer;
    if (
      !document.querySelector(
        'script[src="https://www.youtube.com/iframe_api"]',
      )
    ) {
      const tag = document.createElement("script");
      tag.src = "https://www.youtube.com/iframe_api";
      const first = document.getElementsByTagName("script")[0];
      if (first?.parentNode) first.parentNode.insertBefore(tag, first);
      else document.head.appendChild(tag);
    }
  }

  /* ══════════════════════════════════
     SPOTIFY CONTROLLERS (IFrame API)
     ══════════════════════════════════ */
  let spotifyBusy = false;
  let spotifyWantsPlay = false;
  let spotifyNavTimer: ReturnType<typeof setTimeout> | null = null;

  function clearSpotifyNavTimer() {
    if (spotifyNavTimer !== null) {
      clearTimeout(spotifyNavTimer);
      spotifyNavTimer = null;
    }
  }

  function updateSpotifyButtonStates() {
    if (activeSource !== "spotify" || !activeSpotifyKey) {
      [prevBtn, nextBtn, playBtn].forEach((btn) => {
        if (!btn) return;
        btn.classList.remove("disabled");
        (btn as HTMLElement).style.pointerEvents = "";
        (btn as HTMLElement).style.opacity = "";
      });
      return;
    }
    const ready = !!spotifyReady[activeSpotifyKey];
    [prevBtn, nextBtn, playBtn].forEach((btn) => {
      if (!btn) return;
      btn.classList.toggle("disabled", !ready);
      (btn as HTMLElement).style.pointerEvents = ready ? "" : "none";
      (btn as HTMLElement).style.opacity = ready ? "" : ".35";
    });
  }

  function startSpotifyNav(targetUri: string, key: string, newIdx: number) {
    if (spotifyBusy) return;
    const ctrl = spotifyControllers[key];
    if (!ctrl || !spotifyReady[key]) return;

    console.log(`[Spotify] → loadUri: ${targetUri} (idx ${newIdx})`);
    spotifyBusy = true;
    spotifyWantsPlay = true;
    spotifyCurrent[key] = newIdx;
    try {
      ctrl.loadUri(targetUri);
    } catch (err) {
      console.warn("[Spotify] loadUri failed", err);
      spotifyBusy = false;
      spotifyWantsPlay = false;
      return;
    }

    clearSpotifyNavTimer();
    spotifyNavTimer = setTimeout(() => {
      spotifyNavTimer = null;
      console.log(
        `[Spotify] ⏱ confirm timeout — no playback_update arrived, firing resume()`,
      );
      try {
        ctrl.resume();
      } catch {}
    }, 1200);
  }

  function initSpotifyControllers() {
    if (!spotifyIFrameAPI) return;

    Object.entries(SPOTIFY_MAP).forEach(([key, { id, uri }]) => {
      const element = document.getElementById(id);
      if (!element) {
        console.warn(`[Spotify] element #${id} not found`);
        return;
      }

      const options = { uri, width: "300", height: "80" };
      const callback = (controller: any) => {
        spotifyControllers[key] = controller;
        console.log(`[Spotify] Controller created: ${key}`);

        controller.addListener("ready", () => {
          console.log(`[Spotify] Embed ready: ${key}`);
          spotifyReady[key] = true;
          updateSpotifyButtonStates();
        });

        controller.addListener("playback_started", (e: any) => {
          console.log(
            `[Spotify] playback_started: ${key}`,
            e?.data?.playingURI,
          );
          spotifyBusy = false;
        });

        /* ── SINGLE SOURCE OF TRUTH for ALL Spotify UI ── */
        controller.addListener("playback_update", (e: any) => {
          const data = e?.data;
          if (!data) return;
          const isActiveSource =
            activeSource === "spotify" && activeSpotifyKey === key;
          if (!isActiveSource) return;

          const isPaused = data.isPaused === true;
          const isPlaying = !isPaused;

          console.log(
            `[Spotify] playback_update: ${key} isPaused=${isPaused} uri=${data.playingURI ?? "none"} pos=${data.position ?? 0}`,
          );

          /* ── clear nav timer: we got a confirming update ── */
          clearSpotifyNavTimer();

          /* ── FALLBACK: if we wanted play but track is paused, resume once ── */
          if (isPaused && spotifyWantsPlay) {
            spotifyWantsPlay = false;
            console.log(`[Spotify] ▶ resume fallback (wantsPlay, isPaused)`);
            try {
              controller.resume();
            } catch {}
            return;
          }
          if (!isPaused) spotifyWantsPlay = false;

          updatePlayButtonState(isPlaying);
          if (isPlaying) startSprinkles();
          else stopSprinkles();

          /* track info from playback URI */
          if (data.playingURI) {
            const tracks = spotifyTracks[key];
            const match = tracks?.find((t) => t.uri === data.playingURI);
            if (match) {
              const idx = tracks.indexOf(match);
              spotifyCurrent[key] = idx;
              currentSpotifyTrack = match;
              setTrackUI(match.name, match.film, match.initials);
              updateQueueHighlight(idx);
            }
          }

          /* scrub bar */
          const pos = data.position || 0;
          const dur = data.duration || 0;
          const currentTimeEl = document.getElementById("currentTime");
          const durationTimeEl = document.getElementById("durationTime");
          const scrubFillEl = document.getElementById("scrubFill");
          if (currentTimeEl) currentTimeEl.textContent = formatTime(pos / 1000);
          if (durationTimeEl)
            durationTimeEl.textContent = formatTime(dur / 1000);
          if (scrubFillEl)
            scrubFillEl.style.width = dur > 0 ? (pos / dur) * 100 + "%" : "0%";
        });
      };

      spotifyIFrameAPI.createController(element, options, callback);
    });
  }

  function loadSpotifyAPI() {
    if (window.Spotify?.IFrameAPI) {
      spotifyIFrameAPI = window.Spotify.IFrameAPI;
      initSpotifyControllers();
      return;
    }
    window.onSpotifyIframeApiReady = (IFrameAPI: any) => {
      spotifyIFrameAPI = IFrameAPI;
      initSpotifyControllers();
    };
    if (
      !document.querySelector(
        'script[src="https://open.spotify.com/embed/iframe-api/v1"]',
      )
    ) {
      const tag = document.createElement("script");
      tag.src = "https://open.spotify.com/embed/iframe-api/v1";
      tag.async = true;
      document.head.appendChild(tag);
    }
  }
  loadSpotifyAPI();

  /* ══════════════════════════════════
     TAB SWITCHING
     ══════════════════════════════════ */
  function pauseCurrentSource() {
    if (
      activeSource === "youtube" &&
      ytPlayer &&
      typeof ytPlayer.pauseVideo === "function"
    ) {
      ytPlayer.pauseVideo();
    } else if (
      activeSource === "spotify" &&
      activeSpotifyKey &&
      spotifyControllers[activeSpotifyKey]
    ) {
      try {
        spotifyControllers[activeSpotifyKey].togglePlay();
      } catch {}
    }
  }

  function getSpotifyKey(playlistUri: string): string | null {
    for (const [key, map] of Object.entries(SPOTIFY_MAP)) {
      if (map.uri === playlistUri) return key;
    }
    return null;
  }

  function switchTab(tab: HTMLElement) {
    const source = tab.dataset.source as "youtube" | "spotify";
    const playlistUri = tab.dataset.playlistUri || "";
    if (tab.classList.contains("active")) return;

    pauseCurrentSource();
    stopSprinkles();
    spotifyBusy = false;
    spotifyWantsPlay = false;
    clearSpotifyNavTimer();

    /* ── reset UI to neutral immediately ── */
    updatePlayButtonState(false);
    setTrackUI("Loading...", "", "🎵");
    const scrubFillEl = document.getElementById("scrubFill");
    const currentTimeEl = document.getElementById("currentTime");
    const durationTimeEl = document.getElementById("durationTime");
    if (scrubFillEl) scrubFillEl.style.width = "0%";
    if (currentTimeEl) currentTimeEl.textContent = "0:00";
    if (durationTimeEl) durationTimeEl.textContent = "0:00";

    document
      .querySelectorAll(".tab")
      .forEach((t) => t.classList.remove("active"));
    tab.classList.add("active");

    activeSource = source;

    if (source === "youtube") {
      activeSpotifyKey = null;
      const t = ytTracks[ytCurrent];
      if (t) setTrackUI(t.name, t.film, t.initials);
      buildQueueList(ytTracks, ytCurrent);
      updatePlayButtonState(false);
    } else {
      const key = getSpotifyKey(playlistUri);
      activeSpotifyKey = key;
      if (key && spotifyTracks[key]?.length > 0) {
        const idx = spotifyCurrent[key] ?? 0;
        const t = spotifyTracks[key][idx];
        if (t) setTrackUI(t.name, t.film, t.initials);
        buildQueueList(spotifyTracks[key], idx);
      } else {
        setTrackUI("Tap play to start", "", "🎵");
      }
      updatePlayButtonState(false);
    }
    updateSpotifyButtonStates();
  }

  /* ── event delegation: survives SPA DOM swaps ── */
  document.addEventListener("click", (e) => {
    const tab = (e.target as HTMLElement).closest(".tab") as HTMLElement;
    if (tab && tab.closest("#sourceTabs")) {
      switchTab(tab);
    }
  });

  /* ══════════════════════════════════
     PLAYER CONTROLS
     ══════════════════════════════════ */

  /* ── prev ── */
  const prevBtn = document.getElementById("prevBtn");
  if (prevBtn) {
    prevBtn.addEventListener("click", () => {
      if (
        activeSource === "youtube" &&
        ytPlayer &&
        typeof ytPlayer.previousVideo === "function"
      ) {
        ytPlayer.previousVideo();
      } else if (activeSource === "spotify" && activeSpotifyKey) {
        const key = activeSpotifyKey;
        const idx = (spotifyCurrent[key] ?? 0) - 1;
        if (idx >= 0 && spotifyTracks[key]?.[idx]) {
          startSpotifyNav(spotifyTracks[key][idx].uri, key, idx);
        }
      }
    });
  }

  /* ── next ── */
  const nextBtn = document.getElementById("nextBtn");
  if (nextBtn) {
    nextBtn.addEventListener("click", () => {
      if (
        activeSource === "youtube" &&
        ytPlayer &&
        typeof ytPlayer.nextVideo === "function"
      ) {
        ytPlayer.nextVideo();
      } else if (activeSource === "spotify" && activeSpotifyKey) {
        const key = activeSpotifyKey;
        const tracks = spotifyTracks[key];
        const idx = (spotifyCurrent[key] ?? 0) + 1;
        if (tracks && idx < tracks.length) {
          startSpotifyNav(tracks[idx].uri, key, idx);
        }
      }
    });
  }

  /* ── play / pause ── */
  const playBtn = document.getElementById("playBtn");
  if (playBtn) {
    playBtn.addEventListener("click", () => {
      if (activeSource === "youtube" && ytPlayer) {
        const state = ytPlayer.getPlayerState ? ytPlayer.getPlayerState() : -1;
        if (state === 1) {
          ytPlayer.pauseVideo();
          updatePlayButtonState(false);
          stopSprinkles();
        } else {
          ytPlayer.playVideo();
          updatePlayButtonState(true);
          startSprinkles();
        }
      } else if (activeSource === "spotify" && activeSpotifyKey) {
        if (spotifyControllers[activeSpotifyKey]) {
          try {
            spotifyControllers[activeSpotifyKey].togglePlay();
          } catch {}
        }
      }
    });
  }

  /* ── scrub ── */
  const scrubTrackEl = document.getElementById("scrubTrack");
  if (scrubTrackEl) {
    scrubTrackEl.addEventListener("click", (e: MouseEvent) => {
      const rect = scrubTrackEl.getBoundingClientRect();
      const pct = Math.max(
        0,
        Math.min(1, (e.clientX - rect.left) / rect.width),
      );
      if (
        activeSource === "youtube" &&
        ytPlayer &&
        typeof ytPlayer.getDuration === "function"
      ) {
        const dur = ytPlayer.getDuration() || 0;
        if (dur > 0) ytPlayer.seekTo(pct * dur, true);
      } else if (
        activeSource === "spotify" &&
        activeSpotifyKey &&
        spotifyControllers[activeSpotifyKey]
      ) {
        const dur =
          parseFloat(
            document.getElementById("durationTime")?.textContent || "0",
          ) * 1000;
        if (dur > 0)
          spotifyControllers[activeSpotifyKey].seek((pct * dur) / 1000);
      }
      const scrubFillEl = document.getElementById("scrubFill");
      if (scrubFillEl) scrubFillEl.style.width = pct * 100 + "%";
    });
  }

  /* ── volume ── */
  function makeDraggable(
    trackEl: HTMLElement,
    onChange: (pct: number) => void,
  ) {
    const fill = trackEl.querySelector(".fill") as HTMLElement;
    if (!fill) return;
    function setFromEvent(clientX: number) {
      const rect = trackEl.getBoundingClientRect();
      let pct = (clientX - rect.left) / rect.width;
      pct = Math.max(0, Math.min(1, pct));
      fill.style.width = pct * 100 + "%";
      onChange(pct);
    }
    trackEl.addEventListener("mousedown", (e: MouseEvent) => {
      setFromEvent(e.clientX);
      function move(e: MouseEvent) {
        setFromEvent(e.clientX);
      }
      function up() {
        document.removeEventListener("mousemove", move);
        document.removeEventListener("mouseup", up);
      }
      document.addEventListener("mousemove", move);
      document.addEventListener("mouseup", up);
    });
    trackEl.addEventListener("touchstart", (e: TouchEvent) =>
      setFromEvent(e.touches[0].clientX),
    );
    trackEl.addEventListener("touchmove", (e: TouchEvent) =>
      setFromEvent(e.touches[0].clientX),
    );
  }

  const volTrack = document.querySelector(".vol .track") as HTMLElement;
  const volIcon = document.querySelector(".vol svg") as HTMLElement;
  if (volTrack && volIcon) {
    makeDraggable(volTrack, (pct) => {
      lastVolume = Math.round(pct * 100);
      volIcon.style.opacity = lastVolume === 0 ? ".45" : "1";
      if (
        activeSource === "youtube" &&
        ytPlayer &&
        typeof ytPlayer.setVolume === "function"
      ) {
        ytPlayer.setVolume(lastVolume);
      }
    });
    volIcon.addEventListener("click", () => {
      const fill = volTrack.querySelector(".fill") as HTMLElement;
      if (!fill) return;
      const isMuted = fill.style.width === "0%";
      fill.style.width = isMuted ? lastVolume + "%" : "0%";
      volIcon.style.opacity = isMuted ? "1" : ".45";
      if (
        activeSource === "youtube" &&
        ytPlayer &&
        typeof ytPlayer.setVolume === "function"
      ) {
        ytPlayer.setVolume(isMuted ? lastVolume : 0);
      }
    });
  }

  const scrubTrack = document.querySelector(".scrub .track") as HTMLElement;
  if (scrubTrack) makeDraggable(scrubTrack, () => {});
</script>
