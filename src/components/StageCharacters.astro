---
---

<div class="stage-chars">
  <!-- 🕺 Baraati — left side, dancing -->
  <div class="stage-char char-baraati" style="left:8%; bottom:38%;">
    <svg width="28" height="42" viewBox="0 0 40 60">
      <circle cx="20" cy="9" r="6" fill="#F7ECD9"/>
      <path d="M20 15 L20 42" stroke="#E8871E" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="20" y1="20" x2="6" y2="16" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="20" y1="20" x2="34" y2="14" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-l" x1="20" y1="42" x2="10" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-r" x1="20" y1="42" x2="30" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <!-- sehra (groom headgear) -->
      <rect x="14" y="2" width="12" height="4" rx="2" fill="#D4A017" opacity=".8"/>
    </svg>
  </div>

  <!-- 💃 Sangeet dancer — right side -->
  <div class="stage-char char-dancer" style="right:8%; bottom:36%;">
    <svg width="28" height="44" viewBox="0 0 40 60">
      <circle cx="20" cy="9" r="6" fill="#F7ECD9"/>
      <!-- lehenga skirt -->
      <path d="M12 42 L20 28 L28 42 Z" fill="#AD1F5C" opacity=".9"/>
      <path d="M20 15 L20 28" stroke="#AD1F5C" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="20" y1="20" x2="6" y2="12" stroke="#AD1F5C" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="20" y1="20" x2="34" y2="10" stroke="#AD1F5C" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-l" x1="14" y1="42" x2="8" y2="58" stroke="#8C1F3B" stroke-width="3" stroke-linecap="round"/>
      <line class="char-leg-r" x1="26" y1="42" x2="32" y2="58" stroke="#8C1F3B" stroke-width="3" stroke-linecap="round"/>
      <!-- dupatta -->
      <path d="M20 18 Q30 22 32 30" stroke="#FFD23F" stroke-width="2" fill="none" opacity=".6"/>
    </svg>
  </div>

  <!-- 🥁 Dhol wala — center-left -->
  <div class="stage-char char-dhol" style="left:22%; bottom:34%;">
    <svg width="30" height="42" viewBox="0 0 44 60">
      <circle cx="22" cy="9" r="6" fill="#F7ECD9"/>
      <rect x="12" y="22" width="20" height="13" rx="3" fill="#D4A017"/>
      <path d="M22 15 L22 24" stroke="#E8871E" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="22" y1="20" x2="8" y2="22" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="22" y1="20" x2="36" y2="22" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="22" y1="35" x2="14" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <line x1="22" y1="35" x2="30" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <!-- drum sticks -->
      <line class="char-stick-l" x1="8" y1="22" x2="2" y2="18" stroke="#F7ECD9" stroke-width="2" stroke-linecap="round"/>
      <line class="char-stick-r" x1="36" y1="22" x2="42" y2="18" stroke="#F7ECD9" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- 👩 Chachi — center-right, clapping -->
  <div class="stage-char char-chachi" style="right:22%; bottom:35%;">
    <svg width="26" height="40" viewBox="0 0 40 60">
      <circle cx="20" cy="9" r="6" fill="#F7ECD9"/>
      <!-- saree -->
      <path d="M14 42 L20 28 L26 42 Z" fill="#E8871E" opacity=".85"/>
      <path d="M20 15 L20 28" stroke="#E8871E" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="20" y1="20" x2="10" y2="18" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="20" y1="20" x2="30" y2="18" stroke="#E8871E" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-l" x1="16" y1="42" x2="10" y2="58" stroke="#8C1F3B" stroke-width="3" stroke-linecap="round"/>
      <line class="char-leg-r" x1="24" y1="42" x2="30" y2="58" stroke="#8C1F3B" stroke-width="3" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- 👨 Uncle — far left, bobbing -->
  <div class="stage-char char-uncle" style="left:3%; bottom:30%;">
    <svg width="24" height="38" viewBox="0 0 40 60">
      <circle cx="20" cy="9" r="6" fill="#F7ECD9"/>
      <path d="M20 15 L20 42" stroke="#D4A017" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="20" y1="20" x2="8" y2="28" stroke="#D4A017" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="20" y1="20" x2="32" y2="28" stroke="#D4A017" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-l" x1="20" y1="42" x2="12" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-r" x1="20" y1="42" x2="28" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- 📸 Photographer — far right -->
  <div class="stage-char char-photo" style="right:3%; bottom:32%;">
    <svg width="26" height="40" viewBox="0 0 40 60">
      <circle cx="20" cy="9" r="6" fill="#F7ECD9"/>
      <path d="M20 15 L20 42" stroke="#6B1140" stroke-width="5" stroke-linecap="round"/>
      <line class="char-arm-l" x1="20" y1="20" x2="8" y2="18" stroke="#6B1140" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-arm-r" x1="20" y1="20" x2="34" y2="14" stroke="#6B1140" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-l" x1="20" y1="42" x2="12" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <line class="char-leg-r" x1="20" y1="42" x2="28" y2="58" stroke="#8C1F3B" stroke-width="3.5" stroke-linecap="round"/>
      <!-- camera -->
      <rect class="char-camera" x="30" y="10" width="8" height="6" rx="1.5" fill="#241220" stroke="#F7ECD9" stroke-width="1"/>
      <circle cx="34" cy="13" r="2" fill="#D4A017"/>
    </svg>
  </div>
</div>
