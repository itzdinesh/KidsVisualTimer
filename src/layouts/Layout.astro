---
import '../styles/global.css';
import Player from '../components/Player.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="deluxshaadi" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link href="https://fonts.googleapis.com/css2?family=Yatra+One&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>DeluxShaadi — wedding radio</title>
		<slot name="head" />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-51P3YK1X9C"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-51P3YK1X9C');
		</script>
	</head>
	<body class="overflow-x-hidden" data-theme="90s">
		<div class="scene">
			<div class="rangoli"></div>
			<div class="stars" id="stars"></div>

			<!-- Theme overlays -->
			<div class="theme-overlay theme-overlay-90s"></div>
			<div class="theme-overlay theme-overlay-sangeet"></div>
			<div class="theme-overlay theme-overlay-dj"></div>
			<div class="theme-overlay theme-overlay-vidaai"></div>

			<!-- 90s scanlines -->
			<div class="scanlines"></div>

			<!-- DJ equalizer -->
			<div class="eq-bars">
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
				<div class="eq-bar"></div>
			</div>

			<!-- Sangeet confetti -->
			<div class="confetti-layer" id="confettiLayer"></div>

			<!-- Vidaai petals -->
			<div class="vidaai-petals" id="vidaaiPetals"></div>

			<header>
				<div class="brandmark">
					<div class="glyph">श</div>
					<a href="/" style="text-decoration:none;color:inherit;">DeluxShaadi</a>
				</div>
				<div class="nav-links">
					<a href="/about">About</a>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
					<a href="/contact">Contact</a>
					<button class="navbtn" id="quietCornerToggle" aria-label="Quiet corner mode" title="Quiet corner mode">
						<span aria-hidden="true">&#x1F31A;</span>
					</button>
				</div>
				<button class="hamburger" id="hamburgerBtn" aria-label="Open menu">
					<span></span><span></span><span></span>
				</button>
			</header>

			<div class="nav-overlay" id="navOverlay">
				<button class="overlay-close" id="navClose" aria-label="Close menu">&times;</button>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
				<a href="/contact">Contact</a>
				<button class="overlay-toggle" id="quietCornerToggleOverlay" aria-label="Quiet corner mode" title="Quiet corner mode">
					<span aria-hidden="true">&#x1F31A;</span>
				</button>
			</div>

			<div class="lights" id="lights"></div>

			<main id="page-content">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-links">
					<a href="/about">About</a>
					<a href="/privacy">Privacy</a>
					<a href="/terms">Terms</a>
					<a href="/contact">Contact</a>
				</div>
				<p class="footer-copy">&copy; 2026 DeluxShaadi Radio. All rights belong to the original artists and labels.</p>
			</footer>

			<p class="disclaimer">Audio plays through embedded YouTube. Nothing is hosted here, and all rights stay with the labels and performers. Song credits from film soundtrack listings.</p>
		</div>

		<Player />

<script>
  /* ── quiet corner toggle (persistent across SPA) ── */
  (function() {
    const toggle = document.getElementById('quietCornerToggle');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let quietModeOn = false;
    const storedMode = localStorage.getItem('quietCornerMode');
    if (storedMode === 'on' && !prefersReduced.matches) {
      quietModeOn = true;
    } else if (storedMode === 'off' && prefersReduced.matches) {
      quietModeOn = false;
    } else if (storedMode === '' && prefersReduced.matches) {
      quietModeOn = true;
      localStorage.setItem('quietCornerMode', 'on');
    }
    if (quietModeOn) document.body.classList.add('quiet-mode');
    function applyQuiet() {
      if (quietModeOn) {
        document.body.classList.add('quiet-mode');
        localStorage.setItem('quietCornerMode', 'on');
      } else {
        document.body.classList.remove('quiet-mode');
        localStorage.setItem('quietCornerMode', 'off');
      }
    }
    if (toggle) toggle.addEventListener('click', () => { quietModeOn = !quietModeOn; applyQuiet(); });
    const overlayToggle = document.getElementById('quietCornerToggleOverlay');
    if (overlayToggle) overlayToggle.addEventListener('click', () => { quietModeOn = !quietModeOn; applyQuiet(); });
  })();

  /* ═══════════════════════════════════
     SHAADI PERSONALIZATION
     ═══════════════════════════════════ */
  function initShaadi() {
    const overlay = document.getElementById('shaadiOverlay');
    const form = document.getElementById('shaadiForm') as HTMLFormElement | null;
    const ctaBtn = document.getElementById('shaadiCta');
    const editBtn = document.getElementById('shaadiEdit');
    const closeBtn = document.getElementById('shaadiClose');
    const resetBtn = document.getElementById('shaadiReset');
    const brideInput = document.getElementById('brideInput') as HTMLInputElement | null;
    const groomInput = document.getElementById('groomInput') as HTMLInputElement | null;
    const heroDefault = document.getElementById('heroDefault');
    const heroPersonalized = document.getElementById('heroPersonalized');
    const heroNames = document.getElementById('heroNames');
    if (!overlay || !form || !brideInput || !groomInput) return;

    function openModal() {
      overlay.classList.add('open');
      const params = new URLSearchParams(window.location.search);
      const eb = params.get('bride') || '';
      const eg = params.get('groom') || '';
      brideInput.value = eb ? decodeURIComponent(eb) : '';
      groomInput.value = eg ? decodeURIComponent(eg) : '';
      if (resetBtn) resetBtn.classList.toggle('hidden', !eb && !eg);
      setTimeout(() => brideInput.focus(), 100);
    }
    function closeModal() { overlay.classList.remove('open'); }

    if (ctaBtn) ctaBtn.addEventListener('click', openModal);
    if (editBtn) editBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

    function applyPersonalization(bride: string, groom: string) {
      if (!heroDefault || !heroPersonalized || !heroNames) return;
      if (!bride && !groom) {
        heroDefault.style.display = '';
        heroPersonalized.style.display = 'none';
        if (ctaBtn) ctaBtn.classList.remove('hidden');
        return;
      }
      heroDefault.style.display = 'none';
      heroPersonalized.style.display = '';
      /* graceful single-name handling */
      const display = bride && groom
        ? `💍 ${bride.toUpperCase()} <span class="heart">❤️</span> ${groom.toUpperCase()}`
        : bride
          ? `💍 ${bride.toUpperCase()} <span class="heart">❤️</span>`
          : `<span class="heart">❤️</span> ${groom.toUpperCase()}`;
      heroNames.innerHTML = display;
      heroNames.classList.add('shimmer');
      if (ctaBtn) ctaBtn.classList.add('hidden');
    }

    function setUrlParams(bride: string, groom: string) {
      const url = new URL(window.location.href);
      if (bride) url.searchParams.set('bride', bride);
      else url.searchParams.delete('bride');
      if (groom) url.searchParams.set('groom', groom);
      else url.searchParams.delete('groom');
      window.history.replaceState({}, '', url.toString());
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const bride = brideInput.value.trim();
      const groom = groomInput.value.trim();
      if (!bride && !groom) return;
      setUrlParams(bride, groom);
      applyPersonalization(bride, groom);
      closeModal();
    });

    if (resetBtn) resetBtn.addEventListener('click', () => {
      brideInput.value = '';
      groomInput.value = '';
      setUrlParams('', '');
      applyPersonalization('', '');
      closeModal();
    });

    /* on load: check URL params */
    const params = new URLSearchParams(window.location.search);
    const initBride = params.get('bride') || '';
    const initGroom = params.get('groom') || '';
    if (initBride || initGroom) {
      applyPersonalization(
        initBride ? decodeURIComponent(initBride) : '',
        initGroom ? decodeURIComponent(initGroom) : '',
      );
    }
  }
  initShaadi();

  /* ═══════════════════════════════════
     BARAAT MODE
     ═══════════════════════════════════ */
  (function initBaraat() {
    const btn = document.getElementById('baraatBtn');
    const meter = document.getElementById('energyMeter');
    const fill = document.getElementById('energyFill');
    const pctEl = document.getElementById('energyPct');
    const banner = document.getElementById('baraatBanner');
    if (!btn || !meter || !fill || !pctEl || !banner) return;

    let active = false;
    let energyAnim = 0;
    let currentEnergy = 0;
    let petalInterval: ReturnType<typeof setInterval> | null = null;
    let confettiInterval: ReturnType<typeof setInterval> | null = null;
    let bannerTimeout: ReturnType<typeof setTimeout> | null = null;

    const MAX_SPRINKLES = 20;
    const MAX_CONFETTI = 25;

    function spawnBaraatPetal() {
      const layer = document.getElementById('petalLayer');
      if (!layer) return;
      if (layer.children.length >= MAX_SPRINKLES) return;
      const el = document.createElement('div');
      el.className = 'baraat-petal';
      const colors = ['#E8871E', '#FFD23F', '#FF6B6B', '#AD1F5C', '#F7ECD9', '#FF9ECD'];
      el.style.background = colors[Math.floor(Math.random() * colors.length)];
      el.style.left = Math.random() * 100 + '%';
      el.style.setProperty('--fall-duration', (2 + Math.random() * 2) + 's');
      el.style.setProperty('--drift', (Math.random() * 80 - 40) + 'px');
      el.style.setProperty('--spin', (Math.random() * 720 - 360) + 'deg');
      el.addEventListener('animationend', () => el.remove());
      layer.appendChild(el);
    }

    function spawnBaraatConfetti() {
      const layer = document.getElementById('confettiLayer');
      if (!layer) return;
      if (layer.children.length >= MAX_CONFETTI) return;
      const el = document.createElement('div');
      el.className = 'baraat-confetti';
      const colors = ['#FF6B9D', '#FFD23F', '#E8871E', '#AD1F5C', '#FF9ECD', '#fff', '#00D4FF'];
      el.style.background = colors[Math.floor(Math.random() * colors.length)];
      el.style.left = Math.random() * 100 + '%';
      el.style.setProperty('--fall-duration', (2.5 + Math.random() * 2.5) + 's');
      el.style.setProperty('--drift', (Math.random() * 70 - 35) + 'px');
      el.style.setProperty('--spin', (Math.random() * 900 - 450) + 'deg');
      el.addEventListener('animationend', () => el.remove());
      layer.appendChild(el);
    }

    function startParticles() {
      if (petalInterval) return;
      petalInterval = setInterval(spawnBaraatPetal, 200);
      confettiInterval = setInterval(spawnBaraatConfetti, 280);
    }

    function stopParticles() {
      if (petalInterval) { clearInterval(petalInterval); petalInterval = null; }
      if (confettiInterval) { clearInterval(confettiInterval); confettiInterval = null; }
    }

    function animateEnergy(from: number, to: number, duration: number) {
      const start = performance.now();
      function tick(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        /* ease-out cubic */
        const eased = 1 - Math.pow(1 - progress, 3);
        currentEnergy = Math.round(from + (to - from) * eased);
        fill.style.width = currentEnergy + '%';
        pctEl.textContent = currentEnergy + '%';
        if (progress < 1) {
          energyAnim = requestAnimationFrame(tick);
        }
      }
      cancelAnimationFrame(energyAnim);
      energyAnim = requestAnimationFrame(tick);
    }

    function showBanner() {
      if (bannerTimeout) clearTimeout(bannerTimeout);
      banner.classList.add('show');
      bannerTimeout = setTimeout(() => {
        banner.classList.remove('show');
      }, 3000);
    }

    function startBaraat() {
      active = true;
      document.body.classList.add('baraat-active');
      btn.classList.add('active');
      btn.querySelector('.baraat-btn-text')!.textContent = 'BARAAT IN PROGRESS';
      btn.querySelector('.baraat-btn-icon')!.textContent = '🔥';

      /* start music if not playing */
      const ds = (window as any).__dsPlayer;
      if (ds && !ds.isPlaying()) {
        ds.play();
      }

      /* show energy meter and animate to 100% */
      meter.classList.add('visible');
      animateEnergy(currentEnergy, 100, 2500);

      /* show celebration banner */
      showBanner();

      /* start particles */
      startParticles();
    }

    function stopBaraat() {
      active = false;
      document.body.classList.remove('baraat-active');
      btn.classList.remove('active');
      btn.querySelector('.baraat-btn-text')!.textContent = 'START BARAAT';
      btn.querySelector('.baraat-btn-icon')!.textContent = '🥁';

      /* stop particles */
      stopParticles();

      /* animate energy back down */
      animateEnergy(currentEnergy, 0, 1200);
      setTimeout(() => {
        meter.classList.remove('visible');
      }, 1400);

      /* hide banner */
      if (bannerTimeout) clearTimeout(bannerTimeout);
      banner.classList.remove('show');
    }

    btn.addEventListener('click', () => {
      if (active) {
        stopBaraat();
      } else {
        startBaraat();
      }
    });
  })();

  /* ── hamburger menu (persistent across SPA) ── */
  function initHamburger() {
    const hamburger = document.getElementById('hamburgerBtn');
    const navOverlay = document.getElementById('navOverlay');
    const navClose = document.getElementById('navClose');
    if (!hamburger || !navOverlay) return;
    hamburger.addEventListener('click', () => {
      navOverlay.classList.add('open');
      hamburger.classList.add('open');
    });
    if (navClose) {
      navClose.addEventListener('click', () => {
        navOverlay.classList.remove('open');
        hamburger.classList.remove('open');
      });
    }
    navOverlay.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navOverlay.classList.remove('open');
        hamburger.classList.remove('open');
      });
    });
  }
  initHamburger();

  /* ── active nav link highlight ── */
  function highlightNav(path: string) {
    document.querySelectorAll('.nav-links a, .nav-overlay a').forEach(a => {
      const href = a.getAttribute('href');
      if (!href) return;
      const isActive = href === path || (href !== '/' && path.startsWith(href));
      a.classList.toggle('active', isActive);
    });
  }
  highlightNav(window.location.pathname);

  /* ── stars (persistent) ── */
  const starsWrap = document.getElementById('stars');
  if (starsWrap && starsWrap.children.length === 0) {
    for(let i=0;i<50;i++){
      const s = document.createElement('div');
      s.className='star';
      s.style.left = Math.random()*100+'%';
      s.style.top = Math.random()*70+'%';
      s.style.animationDelay = (Math.random()*3)+'s';
      starsWrap.appendChild(s);
    }
  }

  /* ── lights (persistent) ── */
  const lightsWrap = document.getElementById('lights');
  if (lightsWrap && lightsWrap.children.length === 0) {
    const lightSvg = `<svg width="1440" height="34" viewBox="0 0 1440 34" xmlns="http://www.w3.org/2000/svg" style="position:absolute; left:0; top:0;">`;
    let bulbs = '';
    for(let x=20; x<1440; x+=44){
      const dy = Math.sin(x/90)*6+10;
      const delay = (x%9)/4;
      bulbs += `<circle class="bulb" cx="${x}" cy="${dy}" r="4" style="animation-delay:${delay}s"/>`;
    }
    lightsWrap.innerHTML = lightSvg + bulbs + `</svg>`;
  }

  /* ══════════════════════════════════════
     SPA NAVIGATION — keeps player alive
     ══════════════════════════════════════ */
  const pageContent = document.getElementById('page-content');
  let isNavigating = false;
  const initialPath = window.location.pathname;

  /* ── if user landed on inner page, swap content to home + fix history ── */
  if (initialPath !== '/') {
    window.history.replaceState({}, '', '/');
    fetch('/').then(r => r.text()).then(html => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const homeContent = doc.getElementById('page-content');
      if (homeContent && pageContent) {
        pageContent.innerHTML = homeContent.innerHTML;
        highlightNav('/');
        window.scrollTo(0, 0);
        initShaadi();
      }
    });
  }

  async function loadPage(url: string, fromPopstate = false) {
    if (isNavigating) return;
    isNavigating = true;
    try {
      const res = await fetch(url);
      if (!res.ok) { window.location.href = url; return; }
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const newContent = doc.getElementById('page-content');
      const newTitle = doc.querySelector('title');
      if (!newContent) { window.location.href = url; return; }

      const prevUrl = window.location.pathname;

      pageContent!.innerHTML = newContent.innerHTML;
      if (newTitle) document.title = newTitle.textContent || document.title;
      highlightNav(url);
      window.scrollTo(0, 0);
      initShaadi();

      /* history: back/forward uses browser's own history, don't touch it */
      if (!fromPopstate) {
        if (prevUrl === '/') {
          /* home → inner: push so back goes home */
          window.history.pushState({}, '', url);
        } else {
          /* inner → anything: replace so back always goes home directly */
          window.history.replaceState({}, '', url);
        }
      }

      pageContent!.querySelectorAll('script').forEach(old => {
        const s = document.createElement('script');
        if (old.src) { s.src = old.src; }
        else { s.textContent = old.textContent; }
        old.replaceWith(s);
      });
    } catch {
      window.location.href = url;
    } finally {
      isNavigating = false;
    }
  }

  /* ── click interception ── */
  document.addEventListener('click', (e: MouseEvent) => {
    const a = (e.target as HTMLElement).closest('a[href]');
    if (!a) return;
    const href = a.getAttribute('href')!;
    if (href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return;
    e.preventDefault();
    if (href === window.location.pathname) return;
    loadPage(href);
  });

  /* ── back/forward: just load the content, browser already set the URL ── */
  window.addEventListener('popstate', () => {
    loadPage(window.location.pathname, true);
  });
</script>
	</body>
</html>
