---
import Layout from '../layouts/Layout.astro';
import MandapScene from '../components/MandapScene.astro';
import BaraatDancers from '../components/BaraatDancers.astro';
---

<Layout>
	<Fragment slot="head">
		<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is DeluxShaadi Radio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It's a wedding radio station that plays Hindi wedding and sangeet songs on a continuous loop, similar to how a DJ keeps the music going all night at a real wedding hall."
      }
    },
    {
      "@type": "Question",
      "name": "Is DeluxShaadi Radio free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the site is completely free to listen to. There's no signup, subscription, or payment required."
      }
    },
    {
      "@type": "Question",
      "name": "What kind of songs does DeluxShaadi Radio play?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A mix of classic and newer Bollywood wedding songs — baraat entrance tracks, sangeet dance numbers, mehendi songs, and emotional vidaai songs."
      }
    },
    {
      "@type": "Question",
      "name": "Can I choose or skip songs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can use the next and previous buttons to skip tracks, or open the song list to jump straight to any track in the playlist."
      }
    },
    {
      "@type": "Question",
      "name": "Does DeluxShaadi Radio work on mobile phones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the site is built to work on both desktop and mobile browsers."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the music come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Audio plays through embedded YouTube — nothing is hosted or downloaded, and all rights remain with the original labels and artists."
      }
    },
    {
      "@type": "Question",
      "name": "Can I play DeluxShaadi Radio at an actual wedding or sangeet function?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It works well as ambient background music for small gatherings, sangeet nights, or mehendi functions where you want continuous music without manually queuing songs."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No account or login is required — just open the site and start listening."
      }
    }
  ]
}
		</script>
	</Fragment>

	<div class="hero max-sm:px-3.5 max-sm:py-2 max-sm:pb-6">
		<div class="kicker max-sm:text-[10px] max-sm:tracking-widest max-sm:mb-3">now playing · dhol ke saath</div>
		<h1>शादी रेडियो<span class="eng">wedding songs, playing all night</span></h1>
		<p class="tagline">Baraat to vidaai, one long tape that never stops — old favourites and new sangeet hits on loop, the way the DJ at every wedding hall keeps it going till 2am.</p>
	</div>

	<MandapScene />

	<div class="tabs max-sm:overflow-x-auto max-sm:overflow-y-hidden max-sm:flex-nowrap max-sm:justify-start max-sm:gap-1.5 max-sm:px-3 max-sm:-mt-28" id="sourceTabs">
		<button class="tab active max-sm:shrink-0 max-sm:py-1.5 max-sm:px-3.5 max-sm:text-xs" data-tab-key="90s">90s Songs</button>
		<button class="tab max-sm:shrink-0 max-sm:py-1.5 max-sm:px-3.5 max-sm:text-xs" data-tab-key="sangeet">Sangeet</button>
		<button class="tab max-sm:shrink-0 max-sm:py-1.5 max-sm:px-3.5 max-sm:text-xs" data-tab-key="dj">DJ Songs</button>
		<button class="tab max-sm:shrink-0 max-sm:py-1.5 max-sm:px-3.5 max-sm:text-xs" data-tab-key="vidaai">Vidaai</button>
	</div>

	<BaraatDancers />

	<section class="faq-section max-sm:px-4">
		<h2 class="faq-heading">Frequently Asked Questions</h2>
		<div class="faq-list">
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">What is DeluxShaadi Radio?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>It's a wedding radio station that plays Hindi wedding and sangeet songs on a continuous loop, similar to how a DJ keeps the music going all night at a real wedding hall.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Is DeluxShaadi Radio free to use?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>Yes, the site is completely free to listen to. There's no signup, subscription, or payment required.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">What kind of songs does DeluxShaadi Radio play?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>A mix of classic and newer Bollywood wedding songs — baraat entrance tracks, sangeet dance numbers, mehendi songs, and emotional vidaai songs.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Can I choose or skip songs?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>Yes, you can use the next and previous buttons to skip tracks, or open the song list to jump straight to any track in the playlist.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Does DeluxShaadi Radio work on mobile phones?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>Yes, the site is built to work on both desktop and mobile browsers.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Where does the music come from?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>Audio plays through embedded YouTube — nothing is hosted or downloaded, and all rights remain with the original labels and artists.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Can I play DeluxShaadi Radio at an actual wedding or sangeet function?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>It works well as ambient background music for small gatherings, sangeet nights, or mehendi functions where you want continuous music without manually queuing songs.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q max-sm:py-3 max-sm:pr-10 max-sm:pl-3.5 max-sm:text-[13px]">Do I need to create an account to use it?</summary>
				<div class="faq-a max-sm:px-3.5 max-sm:pb-3"><p>No account or login is required — just open the site and start listening.</p></div>
			</details>
		</div>
	</section>
</Layout>
