---
import Layout from '../layouts/Layout.astro';
import MandapScene from '../components/MandapScene.astro';
import StageCharacters from '../components/StageCharacters.astro';
import BaraatDancers from '../components/BaraatDancers.astro';
---

<Layout>
	<Fragment slot="head">
		<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is DeluxShaadi Radio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It's a wedding radio station that plays Hindi wedding and sangeet songs on a continuous loop, similar to how a DJ keeps the music going all night at a real wedding hall."
      }
    },
    {
      "@type": "Question",
      "name": "Is DeluxShaadi Radio free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the site is completely free to listen to. There's no signup, subscription, or payment required."
      }
    },
    {
      "@type": "Question",
      "name": "What kind of songs does DeluxShaadi Radio play?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A mix of classic and newer Bollywood wedding songs — baraat entrance tracks, sangeet dance numbers, mehendi songs, and emotional vidaai songs."
      }
    },
    {
      "@type": "Question",
      "name": "Can I choose or skip songs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, you can use the next and previous buttons to skip tracks, or open the song list to jump straight to any track in the playlist."
      }
    },
    {
      "@type": "Question",
      "name": "Does DeluxShaadi Radio work on mobile phones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, the site is built to work on both desktop and mobile browsers."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the music come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Audio plays through embedded YouTube — nothing is hosted or downloaded, and all rights remain with the original labels and artists."
      }
    },
    {
      "@type": "Question",
      "name": "Can I play DeluxShaadi Radio at an actual wedding or sangeet function?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It works well as ambient background music for small gatherings, sangeet nights, or mehendi functions where you want continuous music without manually queuing songs."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account to use it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No account or login is required — just open the site and start listening."
      }
    }
  ]
}
		</script>
	</Fragment>

	<div class="hero" id="heroSection">
		<div class="kicker">now playing · dhol ke saath</div>
		<!-- default branding -->
		<div id="heroDefault">
			<h1>शादी रेडियो<span class="eng">wedding songs, playing all night</span></h1>
		</div>
		<!-- personalized branding -->
		<div id="heroPersonalized" class="hero-personalized" style="display:none;">
			<h1 class="hero-names" id="heroNames"></h1>
			<h1 class="hero-brand">DELUX SHAADI RADIO</h1>
			<button class="shaadi-edit" id="shaadiEdit">✏️ Edit</button>
		</div>
		<p class="tagline">Baraat to vidaai, one long tape that never stops — old favourites and new sangeet hits on loop, the way the DJ at every wedding hall keeps it going till 2am.</p>
		<button class="shaadi-cta" id="shaadiCta">
			<span class="shaadi-cta-icon">💍</span>
			<span class="shaadi-cta-text">Personalize Shaadi</span>
		</button>
		<button class="baraat-btn" id="baraatBtn">
			<span class="baraat-btn-icon">🥁</span>
			<span class="baraat-btn-text">START BARAAT</span>
		</button>
	</div>

	<!-- Shaadi modal -->
	<div class="shaadi-overlay" id="shaadiOverlay">
		<div class="shaadi-modal" id="shaadiModal">
			<button class="shaadi-close" id="shaadiClose" aria-label="Close">&times;</button>
			<h2 class="shaadi-modal-title">Whose Shaadi Is It?</h2>
			<form id="shaadiForm" class="shaadi-form" autocomplete="off">
				<label class="shaadi-label">
					<span>Bride</span>
					<input type="text" id="brideInput" placeholder="Enter name" maxlength="30" />
				</label>
				<label class="shaadi-label">
					<span>Groom</span>
					<input type="text" id="groomInput" placeholder="Enter name" maxlength="30" />
				</label>
				<button type="submit" class="shaadi-submit">💍 Enter Shaadi</button>
				<button type="button" class="shaadi-reset" id="shaadiReset">Remove Names</button>
			</form>
		</div>
	</div>

	<div class="stage-wrap">
		<MandapScene />
		<StageCharacters />
		<!-- Baraat celebration banner -->
		<div class="baraat-banner" id="baraatBanner">
			<span class="baraat-banner-text">🔥 BARAAT HAS ARRIVED!</span>
		</div>
	</div>

	<!-- Shaadi Energy meter -->
	<div class="energy-meter" id="energyMeter">
		<span class="energy-label">Shaadi Energy</span>
		<div class="energy-track">
			<div class="energy-fill" id="energyFill" style="width:0%"></div>
		</div>
		<span class="energy-pct" id="energyPct">0%</span>
	</div>

	<div class="tabs" id="sourceTabs">
		<button class="tab active" data-tab-key="90s">90s Songs</button>
		<button class="tab" data-tab-key="sangeet">Sangeet</button>
		<button class="tab" data-tab-key="dj">DJ Songs</button>
		<button class="tab" data-tab-key="vidaai">Vidaai</button>
	</div>

	<BaraatDancers />

	<section class="faq-section">
		<h2 class="faq-heading">Frequently Asked Questions</h2>
		<div class="faq-list">
			<details class="faq-item">
				<summary class="faq-q">What is DeluxShaadi Radio?</summary>
				<div class="faq-a"><p>It's a wedding radio station that plays Hindi wedding and sangeet songs on a continuous loop, similar to how a DJ keeps the music going all night at a real wedding hall.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Is DeluxShaadi Radio free to use?</summary>
				<div class="faq-a"><p>Yes, the site is completely free to listen to. There's no signup, subscription, or payment required.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">What kind of songs does DeluxShaadi Radio play?</summary>
				<div class="faq-a"><p>A mix of classic and newer Bollywood wedding songs — baraat entrance tracks, sangeet dance numbers, mehendi songs, and emotional vidaai songs.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Can I choose or skip songs?</summary>
				<div class="faq-a"><p>Yes, you can use the next and previous buttons to skip tracks, or open the song list to jump straight to any track in the playlist.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Does DeluxShaadi Radio work on mobile phones?</summary>
				<div class="faq-a"><p>Yes, the site is built to work on both desktop and mobile browsers.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Where does the music come from?</summary>
				<div class="faq-a"><p>Audio plays through embedded YouTube — nothing is hosted or downloaded, and all rights remain with the original labels and artists.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Can I play DeluxShaadi Radio at an actual wedding or sangeet function?</summary>
				<div class="faq-a"><p>It works well as ambient background music for small gatherings, sangeet nights, or mehendi functions where you want continuous music without manually queuing songs.</p></div>
			</details>
			<details class="faq-item">
				<summary class="faq-q">Do I need to create an account to use it?</summary>
				<div class="faq-a"><p>No account or login is required — just open the site and start listening.</p></div>
			</details>
		</div>
	</section>
</Layout>
