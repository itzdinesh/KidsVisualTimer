---
import Layout from '../layouts/Layout.astro';
import Player from '../components/Player.astro';
---

<Layout>
	<div class="scene">
		<div class="rangoli"></div>
		<div class="stars" id="stars"></div>

		<header>
			<div class="brandmark">
				<div class="glyph">श</div>
				<a href="/" style="text-decoration:none;color:inherit;">DeluxShaadi</a>
			</div>
			<nav>
				<a href="/about">About</a>
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
				<a href="/contact">Contact</a>
				<button class="navbtn" id="quietCornerToggle" aria-label="Quiet corner mode" title="Quiet corner mode">
					<span aria-hidden="true">&#x1F31A;</span>
				</button>
			</nav>
		</header>

		<div class="lights" id="lights"></div>

		<div class="error-page">
			<div class="error-code">500</div>
			<h1 class="error-title">Dhol toot gaya<span class="eng">something went wrong</span></h1>
			<p class="error-desc">The server hit a snag mid-beat. Try refreshing the page — the music will be back in a moment.</p>
			<a href="/" class="error-btn">Back to the Dance Floor</a>
		</div>

		<footer class="site-footer">
			<div class="footer-links">
				<a href="/about">About</a>
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
				<a href="/contact">Contact</a>
			</div>
			<p class="footer-copy">&copy; 2026 DeluxShaadi Radio. All rights belong to the original artists and labels.</p>
		</footer>

		<p class="disclaimer">Audio plays through embedded YouTube. Nothing is hosted here, and all rights stay with the labels and performers. Song credits from film soundtrack listings.</p>

<script>
  (function() {
    const toggle = document.getElementById('quietCornerToggle');
    if (!toggle) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let quietModeOn = false;
    const storedMode = localStorage.getItem('quietCornerMode');
    if (storedMode === 'on' && !prefersReduced.matches) {
      quietModeOn = true;
    } else if (storedMode === 'off' && prefersReduced.matches) {
      quietModeOn = false;
    } else if (storedMode === '' && prefersReduced.matches) {
      quietModeOn = true;
      localStorage.setItem('quietCornerMode', 'on');
    }
    if (quietModeOn) document.body.classList.add('quiet-mode');
    toggle.addEventListener('click', () => {
      quietModeOn = !quietModeOn;
      if (quietModeOn) {
        document.body.classList.add('quiet-mode');
        localStorage.setItem('quietCornerMode', 'on');
      } else {
        document.body.classList.remove('quiet-mode');
        localStorage.setItem('quietCornerMode', 'off');
      }
    });
  })();
</script>
	</div>

	<Player />
</Layout>
